#!/usr/bin/env bash
set -euo pipefail

SOURCE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "$(git -C "$SOURCE_ROOT" status --porcelain)" ]]; then
    printf '%s\n' 'deploy refused: source commit is not clean and frozen' >&2
    exit 2
fi

HERMES_TARGET="${HERMES_DEPLOY_HOME:-/home/van-gogh/.hermes}"
BIN_TARGET="${HARNESS_BIN_DIR:-/home/van-gogh/.local/bin}"
GROUP_TARGET="${GROUP_PROJECT_ROOT:-/home/van-gogh/project/Rust_code/Group}"
install -d -m 0755 "$HERMES_TARGET/skills/software-development/codex-harness"
install -d -m 0755 "$HERMES_TARGET/plugins/codex-harness-context" "$BIN_TARGET"
cp -a "$SOURCE_ROOT/skill/." "$HERMES_TARGET/skills/software-development/codex-harness/"
cp -a "$SOURCE_ROOT/plugin/." "$HERMES_TARGET/plugins/codex-harness-context/"
install -m 0755 "$SOURCE_ROOT/bin/harness" "$BIN_TARGET/harness"
install -d -m 0755 "$GROUP_TARGET/.harness"
install -m 0644 "$SOURCE_ROOT/projects/Group/config.toml" "$GROUP_TARGET/.harness/config.toml"
printf 'deployed_commit=%s\n' "$(git -C "$SOURCE_ROOT" rev-parse HEAD)"
