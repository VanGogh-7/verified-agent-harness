#!/usr/bin/env bash
set -euo pipefail

SOURCE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "$(git -C "$SOURCE_ROOT" status --porcelain)" ]]; then
    printf '%s\n' 'deploy refused: source commit is not clean and frozen' >&2
    exit 2
fi
FROZEN_COMMIT="$(git -C "$SOURCE_ROOT" rev-parse HEAD)"
STAGING_ROOT="$(mktemp -d -t verified-agent-harness-deploy.XXXXXX)"
trap 'rm -r -- "$STAGING_ROOT"' EXIT
git -C "$SOURCE_ROOT" archive --format=tar "$FROZEN_COMMIT" | tar -xf - -C "$STAGING_ROOT"

python3 "$STAGING_ROOT/scripts/deploy_transaction.py" \
    --payload-root "$STAGING_ROOT" --frozen-commit "$FROZEN_COMMIT"
