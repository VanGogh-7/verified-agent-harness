#!/usr/bin/env python3
"""Disable Hermes automatic self-writing using supported 0.19.1 keys."""
from __future__ import annotations

import datetime as dt
import os
from pathlib import Path
import shutil
import tempfile

import yaml


def updated_config(config):
    if not isinstance(config, dict):
        raise ValueError("config root must be a mapping")
    result = dict(config)
    memory = dict(result.get("memory", {}))
    skills = dict(result.get("skills", {}))
    curator = dict(result.get("curator", {}))
    plugins = dict(result.get("plugins", {}))
    legacy_plugin = "codex-harness-context"
    current_plugin = "verified-agent-harness-context"
    for key in ("enabled", "disabled"):
        values = plugins.get(key, [])
        if not isinstance(values, list):
            raise ValueError(f"plugins.{key} must be a list")
        migrated = []
        for value in values:
            renamed = current_plugin if value == legacy_plugin else value
            if renamed not in migrated:
                migrated.append(renamed)
        plugins[key] = migrated
    if current_plugin in plugins["enabled"] and current_plugin in plugins["disabled"]:
        raise ValueError("verified-agent-harness plugin cannot be both enabled and disabled")
    entries = plugins.get("entries", {})
    if not isinstance(entries, dict):
        raise ValueError("plugins.entries must be a mapping")
    entries = dict(entries)
    if legacy_plugin in entries:
        if current_plugin in entries and entries[current_plugin] != entries[legacy_plugin]:
            raise ValueError("conflicting legacy and current verified-agent-harness plugin entries")
        entries.setdefault(current_plugin, entries[legacy_plugin])
        del entries[legacy_plugin]
    plugins["entries"] = entries
    memory.update({"memory_enabled": False, "user_profile_enabled": False,
                   "nudge_interval": 0})
    skills.update({"creation_nudge_interval": 0})
    result.update({"memory": memory, "skills": skills, "curator": curator,
                   "plugins": plugins})
    return result


def main() -> int:
    root = Path(os.environ.get("HERMES_DEPLOY_HOME", str(Path.home() / ".hermes")))
    config_path = root / "config.yaml"
    if config_path.is_symlink() or not config_path.is_file():
        raise SystemExit("configure-hermes refused: config.yaml is missing or symlinked")
    raw = config_path.read_text(encoding="utf-8")
    config = yaml.safe_load(raw) or {}
    try:
        configured = updated_config(config)
    except (TypeError, ValueError) as exc:
        raise SystemExit(f"configure-hermes refused: {exc}") from exc

    stamp = dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    backup = config_path.with_name(f"config.yaml.bak.lifecycle-{stamp}")
    if backup.exists():
        raise SystemExit("configure-hermes refused: backup collision")
    shutil.copy2(config_path, backup, follow_symlinks=False)
    os.chmod(backup, 0o600)

    rendered = yaml.safe_dump(configured, sort_keys=False, allow_unicode=True)
    fd, name = tempfile.mkstemp(prefix=".config.yaml.", dir=root)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(rendered)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(name, 0o600)
        os.replace(name, config_path)
    finally:
        if os.path.exists(name):
            os.unlink(name)
    print(f"hermes_config_backup={backup}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
