#!/usr/bin/env python3
"""Disable Hermes automatic self-writing using supported 0.19.1 keys."""
from __future__ import annotations

import datetime as dt
import os
from pathlib import Path
import shutil
import tempfile

import yaml


def main() -> int:
    root = Path(os.environ.get("HERMES_DEPLOY_HOME", "/home/van-gogh/.hermes"))
    config_path = root / "config.yaml"
    if config_path.is_symlink() or not config_path.is_file():
        raise SystemExit("configure-hermes refused: config.yaml is missing or symlinked")
    raw = config_path.read_text(encoding="utf-8")
    config = yaml.safe_load(raw) or {}
    if not isinstance(config, dict):
        raise SystemExit("configure-hermes refused: config root must be a mapping")

    stamp = dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    backup = config_path.with_name(f"config.yaml.bak.lifecycle-{stamp}")
    if backup.exists():
        raise SystemExit("configure-hermes refused: backup collision")
    shutil.copy2(config_path, backup, follow_symlinks=False)
    os.chmod(backup, 0o600)

    memory = config.setdefault("memory", {})
    skills = config.setdefault("skills", {})
    curator = config.setdefault("curator", {})
    for label, value in (("memory", memory), ("skills", skills), ("curator", curator)):
        if not isinstance(value, dict):
            raise SystemExit(f"configure-hermes refused: {label} must be a mapping")
    memory.update({"memory_enabled": False, "user_profile_enabled": False,
                   "nudge_interval": 0, "write_approval": True})
    skills.update({"creation_nudge_interval": 0, "write_approval": True})
    curator["enabled"] = False

    rendered = yaml.safe_dump(config, sort_keys=False, allow_unicode=True)
    fd, name = tempfile.mkstemp(prefix=".config.yaml.", dir=root)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(rendered)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(name, 0o600)
        os.replace(name, config_path)
    finally:
        if os.path.exists(name):
            os.unlink(name)
    print(f"hermes_config_backup={backup}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
