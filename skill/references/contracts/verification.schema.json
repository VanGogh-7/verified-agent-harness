{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://verified-agent-harness.invalid/schemas/verification.schema.json", "title": "Independent Verifier report", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "attempt", "base_sha", "candidate_id", "classifications", "decision", "limitations"],
  "properties": {"schema_version": {"type": "string", "enum": ["1.0"]}, "status": {"type": "string", "enum": ["completed", "blocked"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "attempt": {"type": "integer", "minimum": 1}, "base_sha": {"type": "string", "minLength": 40, "maxLength": 64}, "candidate_id": {"type": "string", "minLength": 77, "maxLength": 77}, "classifications": {"type": "array", "maxItems": 768, "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "classification", "policy_blocking", "rationale", "evidence"], "properties": {"finding_id": {"type": "string", "minLength": 1, "maxLength": 128}, "classification": {"type": "string", "enum": ["confirmed", "rejected", "inconclusive", "flaky_or_infra"]}, "policy_blocking": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}, "evidence": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2000}}}}}, "decision": {"type": "string", "enum": ["approved", "changes_required", "blocked"]}, "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 2000}}}
}
