{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://verified-agent-harness.invalid/schemas/review.schema.json", "title": "Correctness Reviewer report", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "attempt", "base_sha", "candidate_id", "findings", "checks_reviewed", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]}, "status": {"type": "string", "enum": ["completed", "blocked"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "attempt": {"type": "integer", "minimum": 1}, "base_sha": {"type": "string", "minLength": 40, "maxLength": 64}, "candidate_id": {"type": "string", "minLength": 77, "maxLength": 77},
    "findings": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "category", "location", "trigger", "evidence", "reproduction", "confidence", "blocking_recommendation"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]}, "category": {"type": "string", "minLength": 1, "maxLength": 128}, "location": {"type": "string", "minLength": 1, "maxLength": 1024}, "trigger": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence": {"type": "string", "minLength": 1, "maxLength": 4000}, "reproduction": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2000}}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "blocking_recommendation": {"type": "boolean"}}}},
    "checks_reviewed": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 2000}}
  }
}
