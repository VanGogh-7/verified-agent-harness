{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-agent-harness.invalid/schemas/implementation.schema.json",
  "title": "Implementer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "attempt", "base_sha", "candidate_id", "changed_files", "commands", "decisions", "limitations", "residual_risk", "blockers"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "status": {"type": "string", "enum": ["completed", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "attempt": {"type": "integer", "minimum": 1},
    "base_sha": {"type": "string", "minLength": 40, "maxLength": 64},
    "candidate_id": {"type": "string", "minLength": 77, "maxLength": 77},
    "changed_files": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 1024}},
    "commands": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["command", "status", "exit_code", "summary"], "properties": {"command": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 4096}}, "status": {"type": "string", "enum": ["passed", "failed", "skipped"]}, "exit_code": {"type": "integer"}, "summary": {"type": "string", "maxLength": 2000}}}},
    "decisions": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 2000}},
    "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 2000}},
    "residual_risk": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 2000}},
    "blockers": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2000}}
  }
}
