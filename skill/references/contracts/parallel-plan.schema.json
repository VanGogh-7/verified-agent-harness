{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-agent-harness.invalid/schemas/parallel-plan.schema.json",
  "title": "Hermes parallel decomposition plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "rationale", "base_sha", "shared_contracts", "tasks", "integration"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "decision": {"type": "string", "enum": ["serial", "parallel"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "base_sha": {"type": "string", "minLength": 40, "maxLength": 64},
    "shared_contracts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "paths", "acceptance"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "owner": {"type": "string", "minLength": 1, "maxLength": 128},
          "paths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "acceptance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "depends_on", "write_paths", "acceptance", "contract_ids", "resource_class"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "title": {"type": "string", "minLength": 1, "maxLength": 512},
          "depends_on": {"type": "array", "maxItems": 31, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "write_paths": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "acceptance": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
          "contract_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "resource_class": {"type": "string", "enum": ["light", "heavy"]}
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "gates"],
      "properties": {
        "order": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "gates": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}
      }
    }
  }
}
