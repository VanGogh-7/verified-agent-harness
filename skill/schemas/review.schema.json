{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/schemas/codex-harness/review.schema.json",
  "title": "Codex Reviewer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "checks_reviewed"],
  "properties": {
    "verdict": {"type": "string", "enum": ["approved", "changes_required", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "message"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "file": {"type": "string", "maxLength": 1024},
          "line": {"type": "integer", "minimum": 0},
          "message": {"type": "string", "maxLength": 4000}
        }
      }
    },
    "checks_reviewed": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "approved"}}},
     "then": {"properties": {"findings": {"maxItems": 0}}}},
    {"if": {"properties": {"verdict": {"const": "changes_required"}}},
     "then": {"properties": {"findings": {"minItems": 1}}}}
  ]
}
