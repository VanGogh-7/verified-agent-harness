{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/schemas/codex-harness/quality-gates.schema.json",
  "title": "Deterministic quality-gate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "level", "gates", "completed_at"],
  "properties": {
    "status": {"type": "string", "enum": ["passed", "failed"]},
    "level": {"type": "string", "enum": ["fast", "slice", "stage"]},
    "completed_at": {"type": "string", "maxLength": 128},
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "command"],
        "properties": {
          "name": {"type": "string", "maxLength": 128},
          "status": {"type": "string", "enum": ["passed", "failed", "skipped"]},
          "command": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
          "exit_code": {"type": "integer"},
          "log": {"type": "string", "maxLength": 1024}
        }
      }
    }
  }
}
