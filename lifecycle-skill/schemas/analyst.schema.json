{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["role", "verdict", "architecture", "protected_paths", "quality_gates", "context_files", "adoption_constraints", "findings", "blockers", "gate_gaps", "protected_path_gaps", "unresolved_risks", "recommendations"],
  "properties": {
    "role": {"const": "analyst"},
    "verdict": {"enum": ["PASS", "REQUIRES_CHANGES", "BLOCKED"]},
    "architecture": {"type": "string", "minLength": 1},
    "protected_paths": {"type": "array", "items": {"type": "string"}},
    "quality_gates": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
    "context_files": {"type": "array", "items": {"type": "string"}},
    "adoption_constraints": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "gate_gaps": {"type": "array", "items": {"type": "string"}},
    "protected_path_gaps": {"type": "array", "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{"if": {"properties": {"verdict": {"const": "PASS"}}}, "then": {"properties": {"findings": {"maxItems": 0}, "blockers": {"maxItems": 0}, "gate_gaps": {"maxItems": 0}, "protected_path_gaps": {"maxItems": 0}, "unresolved_risks": {"maxItems": 0}}}}],
  "additionalProperties": false
}
