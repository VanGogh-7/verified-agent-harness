{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["role", "verdict", "findings", "architecture_disagreements", "gate_gaps", "protected_path_gaps"],
  "properties": {
    "role": {"const": "auditor"},
    "verdict": {"enum": ["PASS", "REQUIRES_CHANGES", "BLOCKED"]},
    "findings": {"type": "array", "items": {"type": "string"}},
    "architecture_disagreements": {"type": "array", "items": {"type": "string"}},
    "gate_gaps": {"type": "array", "items": {"type": "string"}},
    "protected_path_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
