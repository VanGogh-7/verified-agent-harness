    r"sk_live_[0-9A-Za-z]{16,}|"
    r"-----BEGIN(?: [A-Z]+)* PRIVATE KEY-----"
    r")"
)


class HarnessError(RuntimeError):
    pass


def enable_child_subreaper() -> None:
    """Make orphaned worker descendants reparent to this dedicated CLI process."""
    if not sys.platform.startswith("linux"):
        raise HarnessError("secure worker lifecycle requires Linux PR_SET_CHILD_SUBREAPER")
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        raise HarnessError(f"cannot enable child subreaper: errno={ctypes.get_errno()}")


def direct_child_pids(parent_pid: int) -> set[int]:
    children: set[int] = set()
    proc_root = pathlib.Path("/proc")
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            raw = (entry / "stat").read_text(encoding="utf-8")
            fields = raw[raw.rfind(")") + 2:].split()
            if len(fields) > 1 and int(fields[1]) == parent_pid:
                children.add(int(entry.name))
        except (FileNotFoundError, PermissionError, ValueError):
            continue
    return children


def current_cgroup_dir() -> pathlib.Path:
    raw = pathlib.Path("/proc/self/cgroup").read_text(encoding="utf-8").strip()
    relative = raw.split(":")[-1].lstrip("/")
    path = pathlib.Path("/sys/fs/cgroup") / relative
    if not (path / "cgroup.controllers").exists() and not (path / "cgroup.procs").exists():
        raise HarnessError("cgroup v2 is unavailable")
    return path


def validate_worker_cgroup(path: pathlib.Path) -> pathlib.Path:
    resolved = path.resolve(strict=True)
    if not resolved.is_relative_to(pathlib.Path("/sys/fs/cgroup")):
        raise HarnessError("worker cgroup is outside cgroup v2")
    if not resolved.name.startswith("verified-agent-harness-"):
        raise HarnessError("invalid worker cgroup identity")
    if not (resolved / "cgroup.procs").is_file() or not (resolved / "cgroup.kill").is_file():
        raise HarnessError("worker cgroup lacks required controls")
    return resolved


def create_worker_cgroup() -> pathlib.Path:
    parent = current_cgroup_dir()
    path = parent / f"verified-agent-harness-{os.getpid()}-{time.time_ns()}"
    try:
        path.mkdir(mode=0o700)
    except OSError as exc:
        raise HarnessError(f"cannot create worker cgroup: {type(exc).__name__}") from exc
    return validate_worker_cgroup(path)


def destroy_worker_cgroup(path: pathlib.Path, kill: bool = True) -> None:
    if not path.exists():
        if (not path.is_absolute() or path.parent == path or
                not path.name.startswith("verified-agent-harness-") or
                not str(path).startswith("/sys/fs/cgroup/")):
            raise HarnessError("invalid missing worker cgroup identity")
        return
    cgroup = validate_worker_cgroup(path)
    if kill:
        try:
            (cgroup / "cgroup.kill").write_text("1", encoding="ascii")
        except OSError as exc:
            raise HarnessError(f"cannot kill worker cgroup: {type(exc).__name__}") from exc
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        events = (cgroup / "cgroup.events").read_text(encoding="ascii")
        if "populated 0" in events:
            break
        time.sleep(0.02)
    else:
        raise HarnessError("worker cgroup did not become empty")
    try:
        cgroup.rmdir()
    except OSError as exc:
        raise HarnessError(f"cannot remove worker cgroup: {type(exc).__name__}") from exc


def terminate_worker_tree(proc: subprocess.Popen[str], parent_waited: bool = False,
                          cgroup: pathlib.Path | None = None) -> int:
    """Terminate the worker process group and all subreaper-adopted descendants."""
    if not parent_waited and proc.poll() is None:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGTERM)
        try:
            proc.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(proc.pid, signal.SIGKILL)
    if proc.poll() is None:
        proc.wait()
    rc = int(proc.returncode if proc.returncode is not None else 1)
    cgroup_error: HarnessError | None = None
    if cgroup is not None:
        try:
            destroy_worker_cgroup(cgroup, kill=True)
        except HarnessError as exc:
            cgroup_error = exc
    for sig in (signal.SIGTERM, signal.SIGKILL):
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, sig)
        deadline = time.monotonic() + 0.5
        while time.monotonic() < deadline:
            adopted = direct_child_pids(os.getpid())
            if not adopted:
                break
            for pid in adopted:
                with contextlib.suppress(ProcessLookupError):
                    os.kill(pid, sig)
            time.sleep(0.02)
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        adopted = direct_child_pids(os.getpid())
        for pid in adopted:
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, signal.SIGKILL)
        while True:
            try:
                waited, _ = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                if cgroup_error is not None:
                    raise cgroup_error
                return rc
            if waited == 0:
                break
        time.sleep(0.02)
    raise HarnessError("adopted worker descendants did not drain")


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def concise(text: str, limit: int) -> str:
    clean = SECRET_VALUE.sub("[REDACTED]", text or "")
    clean = " ".join(clean.split())
    return clean[-limit:] if len(clean) > limit else clean


def read_log_tail(path: pathlib.Path, limit: int) -> str:
    """Read only a bounded tail before redaction; never load an unbounded worker log."""
    byte_limit = max(limit * 4, 4096)
    fd = open_single_link_regular(path, require_owner=False)
    with os.fdopen(fd, "rb") as handle:
        handle.seek(0, os.SEEK_END)
        size = handle.tell()
        handle.seek(max(0, size - byte_limit))
        tail = handle.read(byte_limit).decode("utf-8", errors="replace")
    return concise(tail, limit)


def open_directory_nofollow(directory: pathlib.Path) -> int:
    flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    parent_fd = -1
    try:
        if directory.name == "runtime" and directory.parent.name == ".harness":
            parent_fd = os.open(directory.parent, flags)
            fd = os.open(directory.name, flags, dir_fd=parent_fd)
        else:
            fd = os.open(directory, flags)
    except OSError as exc:
        raise HarnessError(f"cannot safely open runtime directory: {type(exc).__name__}") from exc
    finally:
        if parent_fd >= 0:
            os.close(parent_fd)
    if not stat.S_ISDIR(os.fstat(fd).st_mode):
        os.close(fd)
        raise HarnessError("runtime path is not a directory")
    return fd


def ensure_durable_directory(parent: pathlib.Path, name: str,
                             mode: int = 0o700) -> tuple[pathlib.Path, bool]:
    """Safely create one directory component and durably commit its parent entry."""
    if not name or name in {".", ".."} or "/" in name:
        raise HarnessError("durable directory name must be one normalized component")
    parent_fd = open_directory_nofollow(parent)
    child_fd = -1
    created = False
    creation_observed = False
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        try:
            info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            creation_observed = True
            try:
                os.mkdir(name, mode=mode, dir_fd=parent_fd)
                created = True
            except FileExistsError:
                pass
            info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if not stat.S_ISDIR(info.st_mode):
            raise HarnessError("durable directory component is not a directory")
        child_fd = os.open(name, flags, dir_fd=parent_fd)
        opened = os.fstat(child_fd)
        if (not stat.S_ISDIR(opened.st_mode) or opened.st_dev != info.st_dev or
                opened.st_ino != info.st_ino):
            raise HarnessError("durable directory identity changed during creation")
        if creation_observed:
            os.fsync(child_fd)
            os.fsync(parent_fd)
        return parent / name, created
    except OSError as exc:
        raise HarnessError(f"cannot durably create directory: {type(exc).__name__}") from exc
    finally:
        if child_fd >= 0:
            os.close(child_fd)
        os.close(parent_fd)


def validate_single_link_regular(fd: int, label: str, require_owner: bool = True) -> os.stat_result:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):
        raise HarnessError(f"{label} is not a regular file")
    if info.st_nlink != 1:
        raise HarnessError(f"{label} must have exactly one hard link")
    if require_owner and info.st_uid != os.getuid():
        raise HarnessError(f"{label} is not owned by the current user")
    return info


def open_single_link_regular(path: pathlib.Path, require_owner: bool = True) -> int:
    """Open an artifact without following its final name and reject blocking/special files."""
    directory_fd = open_directory_nofollow(path.parent)
    flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path.name, flags, dir_fd=directory_fd)
    except OSError as exc:
        raise HarnessError(f"cannot safely open artifact {path.name}: {type(exc).__name__}") from exc
    finally:
        os.close(directory_fd)
    try:
        validate_single_link_regular(fd, f"artifact {path.name}", require_owner=require_owner)
    except BaseException:
        os.close(fd)
        raise
    return fd


def atomic_runtime_write(path: pathlib.Path, data: str, mode: int = 0o600) -> None:
    directory_fd = open_directory_nofollow(path.parent)
    tmp_name = f".{path.name}.{os.getpid()}.{time.time_ns()}"
    fd = -1
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(tmp_name, flags, mode, dir_fd=directory_fd)
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            fd = -1
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, path.name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp_name, dir_fd=directory_fd)
        os.close(directory_fd)


def atomic_runtime_json(path: pathlib.Path, value: Any) -> None:
    atomic_runtime_write(path, json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def runtime_unlink(path: pathlib.Path) -> None:
    directory_fd = open_directory_nofollow(path.parent)
    try:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path.name, dir_fd=directory_fd)
    finally:
        os.close(directory_fd)


def clear_directory_fd(directory_fd: int) -> None:
    flags = os.O_RDONLY | (os.O_DIRECTORY if hasattr(os, "O_DIRECTORY") else 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    for name in os.listdir(directory_fd):
        info = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISDIR(info.st_mode):
            child_fd = os.open(name, flags, dir_fd=directory_fd)
            try:
                clear_directory_fd(child_fd)
            finally:
                os.close(child_fd)
            os.rmdir(name, dir_fd=directory_fd)
        else:
            os.unlink(name, dir_fd=directory_fd)


def secure_log_file(path: pathlib.Path):
    """Replace a log name with a fresh, single-link, owner-only regular inode."""
    directory_fd = open_directory_nofollow(path.parent)
    try:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path.name, dir_fd=directory_fd)
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path.name, flags, 0o600, dir_fd=directory_fd)
    except OSError as exc:
        raise HarnessError(f"cannot safely open runtime log {path.name}: {type(exc).__name__}") from exc
    finally:
        os.close(directory_fd)
    try:
        validate_single_link_regular(fd, f"runtime log {path.name}")
        os.fchmod(fd, 0o600)
    except BaseException:
        os.close(fd)
        raise
    return os.fdopen(fd, "w", encoding="utf-8")


def stream_redacted(pipe, log) -> None:
    # A line is withheld until its delimiter (or EOF), so a token split across
    # arbitrary read chunks can never leak an unconfirmed suffix.
    carry = ""
    while True:
        chunk = pipe.read(4096)
        if not chunk:
            break
        carry += chunk
        complete = carry.splitlines(keepends=True)
        carry = ""
        for item in complete:
            if item.endswith(("\n", "\r")):
                log.write(SECRET_VALUE.sub("[REDACTED]", item))
            else:
                carry = item
    if carry:
        log.write(SECRET_VALUE.sub("[REDACTED]", carry))
    log.flush()


def run_logged(argv: list[str], root: pathlib.Path, log_path: pathlib.Path, timeout: int,
               env: dict[str, str]) -> int:
    enable_child_subreaper()
    log = secure_log_file(log_path)
    proc: subprocess.Popen[str] | None = None
    try:
        proc = subprocess.Popen(argv, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, env=env, start_new_session=True)
        if proc.stdout is None:
            raise HarnessError("subprocess output pipe was not created")
        reader = threading.Thread(target=stream_redacted, args=(proc.stdout, log), daemon=True)
        reader.start()
        try:
            rc = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            terminate_worker_tree(proc)
            rc = 124
        else:
            terminate_worker_tree(proc, parent_waited=True)
        reader.join(timeout=5)
        if reader.is_alive():
            with contextlib.suppress(Exception):
                proc.stdout.close()
            reader.join(timeout=0.5)
        if reader.is_alive():
            raise HarnessError("subprocess log drain did not terminate")
        proc.stdout.close()
        os.fsync(log.fileno())
        return rc
    except BaseException:
        if proc is not None:
            with contextlib.suppress(Exception):
                terminate_worker_tree(proc)
        raise
    finally:
        log.close()


def emit(command: str, outcome: str, **fields: Any) -> None:
    parts = [f"HARNESS {command} {outcome}"]
    for key, value in fields.items():
        if value is None or value == "":
            continue
        parts.append(f"{key}={json.dumps(value, ensure_ascii=False, separators=(',', ':'))}")
    print(" ".join(parts))


def run_capture(argv: list[str], cwd: pathlib.Path | None = None, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    env = dict(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    return subprocess.run(argv, cwd=cwd, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, timeout=timeout, check=False, env=env)


def git_root(required: bool = True) -> pathlib.Path | None:
    cp = run_capture(["git", "rev-parse", "--show-toplevel"])
    if cp.returncode != 0:
        if required:
            raise HarnessError("current directory is not inside a Git repository")
        return None
    return pathlib.Path(cp.stdout.strip()).resolve()


def paths(root: pathlib.Path, allow_unsafe_runtime: bool = False) -> dict[str, pathlib.Path]:
    base = root / ".harness"
    runtime = base / "runtime"
    git_dir_result = run_capture(["git", "rev-parse", "--git-dir"], cwd=root)
    if git_dir_result.returncode != 0:
        raise HarnessError("cannot resolve Git metadata directory")
    git_dir = pathlib.Path(git_dir_result.stdout.strip())
    if not git_dir.is_absolute():
        git_dir = (root / git_dir).resolve()
    trusted = git_dir / "harness-control"
    for directory in (base, trusted):
        if directory.is_symlink():
            raise HarnessError(f"refusing symlinked Harness directory: {directory}")
    if runtime.is_symlink() and not allow_unsafe_runtime:
        raise HarnessError(f"refusing symlinked Harness directory: {runtime}")
    for name in ("config.toml", "state.json", "PROJECT_STATE.md", "CURRENT_STAGE.md", "lifecycle.json"):
        candidate = base / name
        if candidate.is_symlink():
            raise HarnessError(f"refusing symlinked Harness control file: {candidate}")
    for name in ("config.toml", "state.json", "CURRENT_STAGE.md", "lifecycle.json",
                 "activation-evidence.json",
                 "orchestrator-checkpoint.json", "implementation.json",
                 "quality-gates.json", "review.json", "state.lock"):
        candidate = trusted / name
        if candidate.is_symlink():
            raise HarnessError(f"refusing symlinked trusted control file: {candidate}")
    return {
        "base": base,
        "runtime": runtime,
        "config": base / "config.toml",
        "state": base / "state.json",
        "project": base / "PROJECT_STATE.md",
        "stage": base / "CURRENT_STAGE.md",
        "trusted": trusted,
        "trusted_config": trusted / "config.toml",
        "trusted_state": trusted / "state.json",
        "trusted_stage": trusted / "CURRENT_STAGE.md",
        "trusted_checkpoint": trusted / "orchestrator-checkpoint.json",
        "trusted_implementation": trusted / "implementation.json",
        "trusted_gates": trusted / "quality-gates.json",
        "trusted_review": trusted / "review.json",
        "lock": trusted / "state.lock",
        "checkpoint": runtime / "orchestrator-checkpoint.json",
    }


def fsync_dir(directory: pathlib.Path) -> None:
    if os.name != "posix":
        return
    fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_write(path: pathlib.Path, data: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = pathlib.Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
        fsync_dir(path.parent)
    finally:
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()


def atomic_json(path: pathlib.Path, value: Any) -> None:
    atomic_write(path, json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


@contextlib.contextmanager
def state_lock(p: dict[str, pathlib.Path]):
    p["trusted"].mkdir(parents=True, exist_ok=True, mode=0o700)
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(p["lock"], flags, 0o600)
    handle = os.fdopen(fd, "a+")
    try:
        if os.name == "posix":
            import fcntl
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        yield
    finally:
        if os.name == "posix":
            import fcntl
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        handle.close()


def load_json(path: pathlib.Path, max_bytes: int = 2 * 1024 * 1024) -> dict[str, Any]:
    try:
        fd = open_single_link_regular(path, require_owner=False)
        with os.fdopen(fd, "rb") as handle:
            raw = handle.read(max_bytes + 1)
        if len(raw) > max_bytes:
            raise HarnessError(f"JSON artifact exceeds {max_bytes} bytes: {path}")
        value = json.loads(raw.decode("utf-8"))
    except FileNotFoundError as exc:
        raise HarnessError(f"missing {path}; run 'harness init'") from exc
    except OSError as exc:
        raise HarnessError(f"cannot safely read JSON artifact {path.name}: {type(exc).__name__}") from exc
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise HarnessError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise HarnessError(f"expected JSON object in {path}")
    return value


def load_state(p: dict[str, pathlib.Path], repair_mirror: bool = False) -> dict[str, Any]:
    source = p["trusted_state"] if p["trusted_state"].exists() else p["state"]
    state = load_json(source)
    if state.get("workflow_state") not in STATES:
        raise HarnessError("state.json contains an unknown workflow_state")
    mirror = json.dumps(state, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    if source == p["trusted_state"] and repair_mirror:
        atomic_runtime_write(p["state"], mirror)
    return state


def save_state(p: dict[str, pathlib.Path], state: dict[str, Any], mirror: bool = True,
               owner_generation: str | None = None) -> None:
    expected_revision = int(state.get("state_revision", 0))
    if p["trusted_state"].exists():
        current = load_json(p["trusted_state"])
        if int(current.get("state_revision", 0)) != expected_revision:
            raise HarnessError("state CAS conflict; reload before writing")
        if owner_generation is not None:
            owner = current.get("owner") or {}
            if owner.get("generation") != owner_generation:
                raise HarnessError("stale Harness owner generation cannot update state")
    state["state_revision"] = expected_revision + 1
    state["updated_at"] = utc_now()
    atomic_json(p["trusted_state"], state)
    if mirror:
        atomic_runtime_json(p["state"], state)


def clear_trusted_evidence(p: dict[str, pathlib.Path]) -> None:
    for key in ("trusted_implementation", "trusted_gates", "trusted_review"):
        with contextlib.suppress(FileNotFoundError):
            p[key].unlink()


def record_transition(state: dict[str, Any], target: str, reason: str) -> None:
    current = state["workflow_state"]
    if target not in STATES or target not in TRANSITIONS.get(current, set()):
        raise HarnessError(f"illegal state transition: {current} -> {target}")
    state["workflow_state"] = target
    events = state.setdefault("recent_transitions", [])
    events.append({"from": current, "to": target, "reason": reason, "at": utc_now()})
    del events[:-12]


def transition(p: dict[str, pathlib.Path], state: dict[str, Any], target: str, reason: str) -> None:
    record_transition(state, target, reason)
    save_state(p, state)


def load_config(p: dict[str, pathlib.Path]) -> dict[str, Any]:
    if tomllib is None:
        raise HarnessError("Python 3.11+ is required (tomllib unavailable)")
    try:
        source = p["trusted_config"] if p["trusted_config"].exists() else p["config"]
        with source.open("rb") as handle:
            cfg = tomllib.load(handle)
    except FileNotFoundError as exc:
        raise HarnessError("missing .harness/config.toml; run 'harness init'") from exc
    except tomllib.TOMLDecodeError as exc:
        raise HarnessError(f"invalid .harness/config.toml: {exc}") from exc
    if cfg.get("config_version") != CONFIG_VERSION:
        raise HarnessError(f"unsupported config_version={cfg.get('config_version')!r}")
    runtime = cfg.get("agent_runtime", {})
    adapter = runtime.get("adapter_argv")
    if not isinstance(adapter, list) or not adapter or not all(isinstance(item, str) for item in adapter):
        raise HarnessError("[agent_runtime].adapter_argv must be a non-empty string array")
    if runtime.get("ephemeral") is not True:
        raise HarnessError("[agent_runtime].ephemeral must be true")
    if cfg.get("harness_version") == HARNESS_VERSION:
        language = cfg.get("language", {})
        required_language = {
            "internal_language": "en", "repository_language": "en",
            "agent_instruction_language": "en", "agent_report_language": "en",
            "operator_language": "auto", "correct_operator_grammar": False,
            "strict_engineering_language": True,
        }
        if any(language.get(key) != value for key, value in required_language.items()):
            raise HarnessError("[language] must preserve the canonical English boundary")
        localization_paths = language.get("product_localization_paths", [])
        if not isinstance(localization_paths, list) or not all(isinstance(item, str) for item in localization_paths):
            raise HarnessError("[language].product_localization_paths must be a string array")
        for item in localization_paths:
            validate_project_relative_path(item.rstrip("/"), "product localization path")
    return cfg


def protected_snapshot(root: pathlib.Path, cfg: dict[str, Any]) -> dict[str, Any]:
    head = run_capture(["git", "rev-parse", "HEAD"], cwd=root).stdout.strip()
    values: dict[str, Any] = {}
    for pattern in cfg.get("protected_paths", []):
        if not isinstance(pattern, str) or pattern.startswith((".git", ".harness/state", ".harness/runtime")):
            continue
        matches = list(root.glob(pattern)) if any(ch in pattern for ch in "*?[") else [root / pattern]
        for path in matches:
            if not path.is_file():
                continue
            relative = str(path.relative_to(root))
            if path.name == ".env" or path.name.startswith(".env.") or SECRET_NAMES.search(relative):
                stat = path.stat()
                values[relative] = {"kind": "secret-metadata", "size": stat.st_size,
                                    "mtime_ns": stat.st_mtime_ns, "mode": stat.st_mode & 0o777}
            else:
                digest = hashlib.sha256(path.read_bytes()).hexdigest()
                values[relative] = {"kind": "sha256", "digest": digest}
    git_dir_result = run_capture(["git", "rev-parse", "--git-dir"], cwd=root)
    git_metadata: dict[str, Any] = {}
    if git_dir_result.returncode == 0:
        git_dir = pathlib.Path(git_dir_result.stdout.strip())
        if not git_dir.is_absolute():
            git_dir = root / git_dir
        for path in sorted(git_dir.rglob("*")):
            key = str(path.relative_to(git_dir))
            if key == "harness-control" or key.startswith("harness-control/"):
                continue
            if path.is_symlink():
                git_metadata[key] = {"kind": "symlink", "target": os.readlink(path)}
            elif path.is_file():
                digest = hashlib.sha256()
                with path.open("rb") as handle:
                    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                        digest.update(chunk)
                git_metadata[key] = {"kind": "sha256", "digest": digest.hexdigest()}
    return {"git_head": head, "git_metadata": git_metadata, "files": values}


def require_protected_unchanged(root: pathlib.Path, cfg: dict[str, Any], state: dict[str, Any]) -> None:
    baseline = state.get("protected_baseline")
    if not isinstance(baseline, dict):
        raise HarnessError("missing protected-path baseline; restart the Stage safely")
    if protected_snapshot(root, cfg) != baseline:
        raise HarnessError("protected paths or Git HEAD changed during the Slice")


def worktree_fingerprint(root: pathlib.Path) -> str:
    """Bind gates/review to changed-file content without reading credential-shaped files."""
    env = dict(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    cp = subprocess.run(["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
                        cwd=root, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                        check=False, env=env)
    if cp.returncode != 0:
        raise HarnessError("failed to fingerprint Git worktree")
    digest = hashlib.sha256(cp.stdout)
    for token in cp.stdout.split(b"\0"):
        if not token:
            continue
        raw_path = token[3:] if len(token) >= 3 and token[2:3] == b" " else token
        relative = raw_path.decode("utf-8", errors="surrogateescape")
        if relative.startswith((".git/", ".harness/")):
            continue
        path = root / relative
        digest.update(raw_path)
        try:
            info = path.lstat()
        except FileNotFoundError:
            digest.update(b"missing")
            continue
        if stat.S_ISLNK(info.st_mode):
            digest.update(b"symlink:")
            digest.update(os.fsencode(os.readlink(path)))
        elif stat.S_ISREG(info.st_mode):
            if path.name == ".env" or path.name.startswith(".env.") or SECRET_NAMES.search(relative):
                metadata = f"secret-metadata:{info.st_size}:{info.st_mtime_ns}:{info.st_mode & 0o777}"
                digest.update(metadata.encode())
            else:
                flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
                fd = os.open(path, flags)
                with os.fdopen(fd, "rb") as handle:
                    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                        digest.update(chunk)
    return digest.hexdigest()


def q(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def toml_array(values: Iterable[str]) -> str:
    return "[" + ", ".join(q(str(v)) for v in values) + "]"


def toml_commands(commands: Iterable[Iterable[str]]) -> str:
    return "[" + ", ".join(toml_array(command) for command in commands) + "]"


def detect_operator_language(text: str, requested: str = "auto") -> str:
    """Resolve a conversation-scoped display language without persisting it."""
    if requested in {"en", "zh"}:
        return requested
    return "zh" if re.search(r"[\u3400-\u9fff]", text or "") else "en"


def operator_message(key: str, language: str) -> str:
    messages = {
        "approval_required": {
            "en": "Explicit operator approval is required before files are changed.",
            "zh": "更改文件前需要操作员明确批准。",
        },
        "assessment_ready": {
            "en": "The read-only assessment is ready for operator review.",
            "zh": "只读评估已完成，等待操作员审阅。",
        },
        "harness_ready": {
            "en": "The project is HARNESS_READY.",
            "zh": "项目已进入 HARNESS_READY。",
        },
    }
    return messages[key][language]


def directory_entries(root: pathlib.Path) -> list[pathlib.Path]:
    ignored = {".DS_Store"}
    return [entry for entry in root.iterdir() if entry.name not in ignored]


def inspect_harness(root: pathlib.Path) -> tuple[str, str | None]:
    base = root / ".harness"
    required = {"config.toml", "state.json", "PROJECT_STATE.md", "CURRENT_STAGE.md"}
    if not base.exists():
        return "ABSENT", None
    if not base.is_dir() or base.is_symlink():
        return "DAMAGED_HARNESS", "invalid_harness_directory"
    present = {name for name in required if (base / name).is_file()}
    if present != required:
        return "DAMAGED_HARNESS", "missing_required_harness_files"
    try:
        if tomllib is None:
            raise ValueError("tomllib unavailable")
        with (base / "config.toml").open("rb") as handle:
            cfg = tomllib.load(handle)
        state = json.loads((base / "state.json").read_text(encoding="utf-8"))
    except Exception:
        return "DAMAGED_HARNESS", "malformed_harness_control_file"
    if cfg.get("config_version") != CONFIG_VERSION:
        return "INCOMPATIBLE_HARNESS", "unsupported_config_version"
    if cfg.get("harness_version") not in COMPATIBLE_HARNESS_VERSIONS:
        return "INCOMPATIBLE_HARNESS", "unsupported_harness_version"
    if state.get("workflow_state") not in STATES:
        return "DAMAGED_HARNESS", "unknown_workflow_state"
    return "COMPATIBLE_HARNESS", None


def lifecycle_detection(root: pathlib.Path) -> dict[str, Any]:
    git = run_capture(["git", "rev-parse", "--show-toplevel"], cwd=root)
    is_git = git.returncode == 0
    project_root = pathlib.Path(git.stdout.strip()).resolve() if is_git else root.resolve()
    dirty = False
    if is_git:
        status_result = run_capture(
            ["git", "status", "--porcelain=v1", "--untracked-files=all"], cwd=project_root)
        dirty = bool(status_result.stdout.strip()) if status_result.returncode == 0 else True
    harness_kind, reason = inspect_harness(project_root)
    if harness_kind == "COMPATIBLE_HARNESS":
        classification, mode = harness_kind, "HARNESS_OPERATION"
    elif harness_kind in {"DAMAGED_HARNESS", "INCOMPATIBLE_HARNESS"}:
        classification, mode = harness_kind, "HARNESS_OPERATION"
    elif is_git:
        classification, mode = "GIT_WITHOUT_HARNESS", "BROWNFIELD_ADOPTION"
    elif not directory_entries(root):
        classification, mode = "EMPTY_DIRECTORY", "GREENFIELD_BOOTSTRAP"
    else:
        classification, mode = "NEW_DIRECTORY", "GREENFIELD_BOOTSTRAP"
    result = {"mode": mode, "classification": classification, "dirty_worktree": dirty,
              "git_repository": is_git, "project_root": str(project_root), "reason": reason}
    if is_git:
        git_dir_result = run_capture(["git", "rev-parse", "--absolute-git-dir"], cwd=project_root)
        if git_dir_result.returncode == 0:
            journal_path = pathlib.Path(git_dir_result.stdout.strip()) / "harness-adoption.json"
            if journal_path.is_file() and not journal_path.is_symlink():
                try:
                    journal = load_json(journal_path)
                    journal_state = journal.get("lifecycle_state")
                    if journal_state in LIFECYCLE_STATES:
                        result["lifecycle_state"] = journal_state
                    if journal_state in {"ADOPTION_PLANNED", "ADOPTION_IN_PROGRESS",
                                         "ADOPTION_INTERRUPTED"}:
                        result.update({"mode": "BROWNFIELD_ADOPTION",
                                       "classification": "INTERRUPTED_ADOPTION",
                                       "reason": "resume_required"})
                except HarnessError:
                    result.update({"classification": "DAMAGED_HARNESS",
                                   "reason": "malformed_adoption_journal"})
    lifecycle_path = None
    if is_git:
        git_dir_result = run_capture(["git", "rev-parse", "--absolute-git-dir"], cwd=project_root)
        if git_dir_result.returncode == 0:
            lifecycle_path = pathlib.Path(git_dir_result.stdout.strip()) / "harness-control/lifecycle.json"
    if harness_kind == "COMPATIBLE_HARNESS" and lifecycle_path is not None and lifecycle_path.is_file():
        try:
            lifecycle = load_json(lifecycle_path)
            result["lifecycle_state"] = lifecycle.get("lifecycle_state")
        except Exception:
            result["classification"] = "DAMAGED_HARNESS"
            result["reason"] = "malformed_lifecycle_state"
    return result


def detect_lifecycle(args: argparse.Namespace) -> None:
    root = pathlib.Path.cwd().resolve()
    result = lifecycle_detection(root)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    else:
        emit("detect", "ok", **result)


def language_lint(text: str, *, parse_structural_exclusions: bool = True) -> dict[str, Any]:
    """Classify engineering prose after structural code/path exclusions."""
    scrubbed = text
    if parse_structural_exclusions:
        scrubbed = re.sub(r"```.*?```", " ", scrubbed, flags=re.DOTALL)
        scrubbed = re.sub(r"`[^`\n]+`", " ", scrubbed)
        scrubbed = re.sub(r"https?://\S+|(?:^|\s)(?:\.?\.?/)?[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+", " ", scrubbed)
        scrubbed = re.sub(r"<!--.*?-->", " ", scrubbed, flags=re.DOTALL)
    latin = 0
    non_latin = 0
    for character in scrubbed:
        if not character.isalpha():
            continue
        name = unicodedata.name(character, "")
        if "LATIN" in name:
            latin += 1
        else:
            non_latin += 1
    total = latin + non_latin
    ratio = non_latin / total if total else 0.0
    if non_latin and (latin == 0 or ratio >= 0.35):
        classification = "FAIL"
    elif non_latin:
        classification = "WARN"
    else:
        classification = "PASS"
    return {"classification": classification, "latin_letters": latin,
            "non_latin_letters": non_latin, "non_latin_ratio": round(ratio, 4)}


class EngineeringProseUnit(NamedTuple):
    text: str
    source_structure_parsed: bool


def markdown_prose_sections(text: str) -> list[EngineeringProseUnit]:
    sections: list[EngineeringProseUnit] = []
    current: list[str] = []
    fence: tuple[str, int] | None = None
    for line in text.splitlines():
        fence_match = re.match(r"^[ \t]{0,3}(`{3,}|~{3,})", line)
        if fence_match:
            marker = fence_match.group(1)
            if fence is None:
                fence = (marker[0], len(marker))
            elif marker[0] == fence[0] and len(marker) >= fence[1]:
                fence = None
            continue
        if fence is not None:
            continue
        heading = re.match(r"^[ \t]{0,3}#{1,6}(?:[ \t]+(.*)|[ \t]*)$", line)
        if heading:
            if any(item.strip() for item in current):
                sections.append(EngineeringProseUnit("\n".join(current), False))
            current = []
            heading_text = heading.group(1) or ""
            heading_text = re.sub(r"[ \t]+#+[ \t]*$", "", heading_text)
            if heading_text.strip():
                sections.append(EngineeringProseUnit(
                    rendered_markdown_heading_prose(heading_text), True))
        else:
            current.append(line)
    if any(item.strip() for item in current):
        sections.append(EngineeringProseUnit("\n".join(current), False))
    return sections


def rendered_markdown_heading_prose(text: str) -> str:
    """Decode only natural-language spans after parsing raw-source exclusions."""
    spans: list[tuple[int, int]] = []
    for pattern in (r"`[^`\n]+`", r"<!--.*?-->"):
        spans.extend(match.span() for match in re.finditer(pattern, text, flags=re.DOTALL))
    link_pattern = re.compile(r"\[[^\]\n]+\]\(([^()\s]+)\)")
    spans.extend(match.span(1) for match in link_pattern.finditer(text))
    path_pattern = re.compile(
        r"https?://\S+|(?:^|\s)(?:\.?\.?/)?[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+")
    spans.extend(match.span() for match in path_pattern.finditer(text))
    merged: list[tuple[int, int]] = []
    for start, end in sorted(spans):
        if merged and start <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
        else:
            merged.append((start, end))
    natural: list[str] = []
    cursor = 0
    for start, end in merged:
        natural.extend((text[cursor:start], " "))
        cursor = end
    natural.append(text[cursor:])
    prose = "".join(natural)
    for _ in range(3):
        decoded = html.unescape(prose)
        if decoded == prose:
            break
        prose = decoded
    return unicodedata.normalize("NFKC", prose)


def require_strict_english(text: str, label: str, *, markdown: bool = False) -> None:
    units = (markdown_prose_sections(text) if markdown else
             [EngineeringProseUnit(text, False)])
    for index, unit in enumerate(units):
        if not unit.text.strip():
            continue
        lint = language_lint(unit.text,
                             parse_structural_exclusions=not unit.source_structure_parsed)
        if lint["classification"] != "PASS":
            raise HarnessError(f"{label} section {index + 1} failed strict engineering-language lint: {lint}")


def engineering_language_check(relative_path: str, text: str,
                               localization_paths: list[str] | None = None) -> str:
    normalized = validate_project_relative_path(relative_path, "engineering artifact path")
    allowed_formats = {".json", ".po", ".properties", ".yaml", ".yml"}
    for prefix in localization_paths or []:
        validate_project_relative_path(prefix.rstrip("/"), "product localization path")
        if normalized == prefix.rstrip("/") or normalized.startswith(prefix.rstrip("/") + "/"):
            if pathlib.PurePosixPath(normalized).suffix.lower() not in allowed_formats:
                raise HarnessError("product localization exclusion uses an unapproved file format")
            if pathlib.PurePosixPath(normalized).suffix.lower() == ".json":
                try:
                    localized = json.loads(text)
                except json.JSONDecodeError as exc:
                    raise HarnessError("product localization JSON is malformed") from exc
                def validate_keys(value: Any) -> None:
                    if isinstance(value, dict):
                        for key, item in value.items():
                            validate_engineering_name(key, "product localization key")
                            validate_keys(item)
                    elif isinstance(value, list):
                        for item in value:
                            validate_keys(item)
                validate_keys(localized)
            return "PASS"
    require_strict_english(text, relative_path,
                           markdown=pathlib.PurePosixPath(normalized).suffix.lower() == ".md")
    return "PASS"


def ensure_english_artifact(path: pathlib.Path, label: str) -> str:
    try:
        fd = open_single_link_regular(path, require_owner=False)
        with os.fdopen(fd, "rb") as handle:
            raw = handle.read(2 * 1024 * 1024 + 1)
        if len(raw) > 2 * 1024 * 1024:
            raise HarnessError(f"{label} exceeds 2 MiB")
        text = raw.decode("utf-8")
    except FileNotFoundError as exc:
        raise HarnessError(f"missing {label}: {path}") from exc
    except (OSError, UnicodeDecodeError) as exc:
        raise HarnessError(f"cannot safely read {label}: {type(exc).__name__}") from exc
    if not text.strip():
        raise HarnessError(f"{label} is empty")
    require_strict_english(text, label, markdown=path.suffix.lower() in {".md", ".markdown"})
    return text


def lifecycle_skill_root() -> pathlib.Path:
    script = pathlib.Path(__file__).resolve()
    candidates = (
        script.parent.parent,                              # current Skill
        script.parents[1].parent / "project-lifecycle-harness",  # installed sibling Skill
    )
    for candidate in candidates:
        try:
            if candidate.is_symlink() or not (candidate / "SKILL.md").is_file():
                continue
            resolved = candidate.resolve(strict=True)
            schemas = resolved / "schemas"
            if schemas.is_dir() and not schemas.is_symlink():
                return resolved
        except OSError:
            continue
    raise HarnessError("project-lifecycle-harness payload cannot be resolved safely")


def validate_schema_value(value: Any, schema: dict[str, Any], where: str = "$") -> None:
    expected = schema.get("type")
    if expected == "object":
        if not isinstance(value, dict):
            raise HarnessError(f"{where} must be an object")
        for key in schema.get("required", []):
            if key not in value:
                raise HarnessError(f"{where}.{key} is required")
        if schema.get("additionalProperties") is False:
            extras = set(value) - set(schema.get("properties", {}))
            if extras:
                raise HarnessError(f"{where} has unexpected fields: {sorted(extras)}")
        for key, item_schema in schema.get("properties", {}).items():
            if key in value:
                validate_schema_value(value[key], item_schema, f"{where}.{key}")
    elif expected == "array":
        if not isinstance(value, list):
            raise HarnessError(f"{where} must be an array")
        if "minItems" in schema and len(value) < schema["minItems"]:
            raise HarnessError(f"{where} must contain at least {schema['minItems']} items")
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            raise HarnessError(f"{where} must contain at most {schema['maxItems']} items")
        for idx, item in enumerate(value):
            validate_schema_value(item, schema.get("items", {}), f"{where}[{idx}]")
    elif expected == "string":
        if not isinstance(value, str):
            raise HarnessError(f"{where} must be a string")
        if "minLength" in schema and len(value) < schema["minLength"]:
            raise HarnessError(f"{where} is shorter than minLength={schema['minLength']}")
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            raise HarnessError(f"{where} exceeds maxLength={schema['maxLength']}")
    elif expected == "integer":
        if not isinstance(value, int) or isinstance(value, bool):
            raise HarnessError(f"{where} must be an integer")
        if "minimum" in schema and value < schema["minimum"]:
            raise HarnessError(f"{where} must be >= {schema['minimum']}")
        if "maximum" in schema and value > schema["maximum"]:
            raise HarnessError(f"{where} must be <= {schema['maximum']}")
    elif expected == "boolean" and not isinstance(value, bool):
        raise HarnessError(f"{where} must be a boolean")
    if "enum" in schema and value not in schema["enum"]:
        raise HarnessError(f"{where} must be one of {schema['enum']}")


def lifecycle_report_document(path: pathlib.Path, role: str) -> tuple[dict[str, Any], str]:
    try:
        fd = open_single_link_regular(path, require_owner=False)
        with os.fdopen(fd, "rb") as handle:
            raw = handle.read(2 * 1024 * 1024 + 1)
        if len(raw) > 2 * 1024 * 1024:
            raise HarnessError(f"{role} report exceeds 2 MiB")
        value = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise HarnessError(f"cannot safely load {role} report: {type(exc).__name__}") from exc
    if not isinstance(value, dict):
        raise HarnessError(f"{role} report must be a JSON object")
    schema_name = {"analyst": "analyst.schema.json", "auditor": "auditor.schema.json",
                   "final_reviewer": "final-review.schema.json"}[role]
    schema_file = lifecycle_skill_root() / "schemas" / schema_name
    try:
        schema = json.loads(schema_file.read_text(encoding="utf-8"))
        validate_schema_value(value, schema)
    except (FileNotFoundError, json.JSONDecodeError) as exc:
        raise HarnessError(f"invalid lifecycle report schema: {schema_name}") from exc
    if value.get("role") != role:
        raise HarnessError(f"malformed {role} report role")
    if value.get("verdict") == "PASS":
        contradictions = [name for name in REPORT_EMPTY_ON_PASS if value.get(name)]
        if contradictions:
            raise HarnessError(f"contradictory PASS {role} report: non-empty {contradictions}")
    prose_fields = ("architecture", "findings", "blockers", "gate_gaps",
                    "protected_path_gaps", "unresolved_risks", "recommendations",
                    "adoption_constraints", "architecture_disagreements", "language_violations")
    for name in prose_fields:
        item = value.get(name)
        if isinstance(item, str):
            require_strict_english(item, f"{role}.{name}")
        elif isinstance(item, list):
            for index, text in enumerate(item):
                if isinstance(text, str):
                    require_strict_english(text, f"{role}.{name}[{index}]")
    return value, hashlib.sha256(raw).hexdigest()


def lifecycle_report(path: pathlib.Path, role: str) -> dict[str, Any]:
    return lifecycle_report_document(path, role)[0]


def validate_engineering_name(value: str, label: str, allow_path: bool = False) -> str:
    pattern = r"[A-Za-z0-9][A-Za-z0-9._/-]*" if allow_path else r"[A-Za-z0-9][A-Za-z0-9_.-]*"
    if not re.fullmatch(pattern, value):
        raise HarnessError(f"{label} must use English-compatible engineering characters: {value!r}")
    return value


def validate_engineering_title(value: str, label: str) -> str:
    if (not re.search(r"[A-Za-z]", value) or
            not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 .,:;()_+/'&-]*", value)):
        raise HarnessError(f"{label} must use English-compatible engineering text")
    return value


def validate_project_relative_path(value: str, label: str) -> str:
    path = pathlib.PurePosixPath(value)
    if (not value or path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts)
            or "\\" in value):
        raise HarnessError(f"{label} must be a normalized project-relative path: {value!r}")
    if any(character in value for character in "*?["):
        raise HarnessError(f"{label} must not contain a glob: {value!r}")
    validate_engineering_name(value, label, allow_path=True)
    if path.parts[0] in {".git", ".harness"}:
        raise HarnessError(f"{label} must not enter Harness or Git control data: {value!r}")
    return value


def safe_project_file(root: pathlib.Path, value: str, label: str) -> dict[str, Any]:
    """Open once through no-follow descriptors and hash the validated file."""
    validate_project_relative_path(value, label)
    parts = pathlib.PurePosixPath(value).parts
    directory_fd = open_directory_nofollow(root)
    fd = -1
    try:
        directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        for part in parts[:-1]:
            next_fd = os.open(part, directory_flags, dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = next_fd
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
        fd = os.open(parts[-1], flags, dir_fd=directory_fd)
        info = validate_single_link_regular(fd, label, require_owner=False)
        if info.st_size > 4 * 1024 * 1024:
            raise HarnessError(f"{label} exceeds 4 MiB")
        with os.fdopen(fd, "rb") as handle:
            fd = -1
            content = handle.read(4 * 1024 * 1024 + 1)
        if len(content) > 4 * 1024 * 1024:
            raise HarnessError(f"{label} exceeds 4 MiB")
        return {"path": value, "sha256": hashlib.sha256(content).hexdigest(),
                "size": len(content), "mode": stat.S_IMODE(info.st_mode)}
    except OSError as exc:
        raise HarnessError(f"unsafe or unavailable {label}: {value!r} ({type(exc).__name__})") from exc
    finally:
        if fd >= 0:
            os.close(fd)
        os.close(directory_fd)


def safe_project_path(root: pathlib.Path, value: str, label: str) -> dict[str, Any]:
    validate_project_relative_path(value.rstrip("/"), label)
    normalized = value.rstrip("/")
    parts = pathlib.PurePosixPath(normalized).parts
    directory_fd = open_directory_nofollow(root)
    fd = -1
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
        directory_flags = flags | getattr(os, "O_DIRECTORY", 0)
        for part in parts[:-1]:
            next_fd = os.open(part, directory_flags, dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = next_fd
        fd = os.open(parts[-1], flags, dir_fd=directory_fd)
        info = os.fstat(fd)
        if stat.S_ISREG(info.st_mode):
            os.close(fd)
            fd = -1
            return safe_project_file(root, normalized, label)
        if stat.S_ISDIR(info.st_mode):
            return {"path": normalized, "kind": "directory"}
        raise HarnessError(f"{label} must be a regular file or directory: {value!r}")
    except OSError as exc:
        raise HarnessError(f"unsafe or unavailable {label}: {value!r} ({type(exc).__name__})") from exc
    finally:
        if fd >= 0:
            os.close(fd)
        os.close(directory_fd)


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True,
                      separators=(",", ":")).encode("utf-8")


def sha256_value(value: Any) -> str:
    return hashlib.sha256(canonical_json(value)).hexdigest()


def validate_machine_language(value: Any, where: str = "$") -> None:
    if isinstance(value, dict):
        for key, item in value.items():
            if not isinstance(key, str) or not re.fullmatch(r"[a-z][a-z0-9_]*", key):
                raise HarnessError(f"machine-facing JSON key is not English snake_case at {where}: {key!r}")
            validate_machine_language(item, f"{where}.{key}")
        state = value.get("lifecycle_state")
        if state is not None and state not in LIFECYCLE_STATES:
            raise HarnessError(f"unknown lifecycle state at {where}: {state!r}")
        workflow = value.get("workflow_state")
        if workflow is not None and workflow not in STATES:
            raise HarnessError(f"unknown workflow state at {where}: {workflow!r}")
    elif isinstance(value, list):
        for index, item in enumerate(value):
            validate_machine_language(item, f"{where}[{index}]")


def repository_identity(root: pathlib.Path) -> dict[str, str]:
    git_dir_result = run_capture(["git", "rev-parse", "--absolute-git-dir"], cwd=root)
    head_result = run_capture(["git", "rev-parse", "--verify", "HEAD"], cwd=root)
    if git_dir_result.returncode != 0 or head_result.returncode != 0:
        raise HarnessError("adoption requires a Git repository with an existing HEAD")
    git_dir = pathlib.Path(git_dir_result.stdout.strip()).resolve(strict=True)
    if git_dir.is_symlink() or not git_dir.is_dir():
        raise HarnessError("Git metadata directory is unsafe")
    identity = hashlib.sha256(canonical_json({"root": str(root.resolve()),
                                              "git_dir": str(git_dir)})).hexdigest()
    return {"repository_id": identity, "root": str(root.resolve()),
            "git_dir": str(git_dir), "head": head_result.stdout.strip()}


def adoption_control(root: pathlib.Path) -> tuple[pathlib.Path, pathlib.Path]:
    identity = repository_identity(root)
    git_dir = pathlib.Path(identity["git_dir"])
    return git_dir / "harness-adoption.json", git_dir


def normalize_adoption_report(text: str) -> str:
    pattern = (r"<!--\s*harness-adoption-approval:start\s*-->.*?"
               r"<!--\s*harness-adoption-approval:end\s*-->")
    marker = "<!-- harness-adoption-approval:start -->\n<APPROVAL_MANIFEST>\n<!-- harness-adoption-approval:end -->"
    if re.search(pattern, text, flags=re.DOTALL | re.IGNORECASE):
        return re.sub(pattern, marker, text, flags=re.DOTALL | re.IGNORECASE)
    return text.rstrip() + "\n\n" + marker + "\n"


def adoption_approval_block(gates: dict[str, list[list[str]]]) -> str:
    payload = json.dumps({"manifest_version": 1, "quality_gate_argv": gates},
                         ensure_ascii=False, indent=2, sort_keys=True)
    return ("<!-- harness-adoption-approval:start -->\n"
            "## Approved Quality-Gate Argv\n\n```json\n" + payload +
            "\n```\n<!-- harness-adoption-approval:end -->")


def concise_diff(path: str, before: str, after: str, limit: int = 1200) -> str:
    diff = "".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
                                        fromfile=f"a/{path}", tofile=f"b/{path}"))
    return diff[:limit]


def mutation_target(root: pathlib.Path, relative: str) -> pathlib.Path:
    if relative.startswith("@git/"):
        return pathlib.Path(repository_identity(root)["git_dir"]) / relative.removeprefix("@git/")
    return root / relative.rstrip("/")


def mutation_entry(root: pathlib.Path, relative: str, desired: bytes | None,
                   *, directory: bool = False, desired_mode: int | None = None) -> dict[str, Any]:
    target = mutation_target(root, relative)
    base = {"path": relative, "prior_exists": False, "prior_sha256": None,
            "prior_mode": None, "desired_sha256": None if desired is None else hashlib.sha256(desired).hexdigest(),
            "desired_mode": desired_mode}
    if target.is_symlink():
        return {**base, "action": "REJECT", "operation": "REJECT", "prior_exists": True,
                "prior_mode": stat.S_IMODE(target.lstat().st_mode), "reason": "symlink target"}
    if directory:
        if not target.exists():
            return {**base, "action": "CREATE", "operation": "CREATE"}
        if target.is_dir():
            prior_mode = stat.S_IMODE(target.stat().st_mode)
            return {**base, "action": "PRESERVE", "operation": "PRESERVE", "prior_exists": True,
                    "prior_mode": prior_mode, "desired_mode": prior_mode}
        return {**base, "action": "REJECT", "operation": "REJECT", "prior_exists": True,
                "prior_mode": stat.S_IMODE(target.stat().st_mode), "reason": "non-directory target"}
    if target.exists() and not target.is_file():
        return {**base, "action": "REJECT", "operation": "REJECT", "prior_exists": True,
                "prior_mode": stat.S_IMODE(target.stat().st_mode), "reason": "special target"}
    if not target.exists():
        return {**base, "action": "CREATE", "operation": "CREATE"}
    fd = open_single_link_regular(target, require_owner=False)
    with os.fdopen(fd, "rb") as handle:
        current = handle.read()
    base.update({"prior_exists": True, "prior_sha256": hashlib.sha256(current).hexdigest(),
                 "prior_mode": stat.S_IMODE(target.stat(follow_symlinks=False).st_mode)})
    if current == desired:
        return {**base, "action": "PRESERVE", "operation": "PRESERVE",
                "desired_mode": base["prior_mode"]}
    before = current.decode("utf-8", errors="replace")
    after = (desired or b"").decode("utf-8", errors="replace")
    return {**base, "action": "MODIFY", "operation": "MODIFY",
            "diff": concise_diff(relative, before, after)}


def gate_input_records(root: pathlib.Path, gates: dict[str, list[list[str]]]) -> list[dict[str, Any]]:
    paths_to_bind: set[str] = set()
    for values in gates.values():
        for argv in values:
            executable = argv[0]
            if executable == "./scripts/verify":
                paths_to_bind.add("scripts/verify")
            elif executable == "npm":
                paths_to_bind.add("package.json")
                for name in ("package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock"):
                    if (root / name).is_file():
                        paths_to_bind.add(name)
            elif executable == "cargo":
                for candidate in root.rglob("Cargo.toml"):
                    relative = candidate.relative_to(root)
                    if not set(relative.parts) & {".git", ".harness"}:
                        paths_to_bind.add(str(relative))
                for name in ("Cargo.lock", "rust-toolchain.toml", "rust-toolchain",
                             ".cargo/config.toml", ".cargo/config"):
                    if (root / name).is_file():
                        paths_to_bind.add(name)
            elif executable == "go":
                paths_to_bind.add("go.mod")
                if (root / "go.sum").is_file():
                    paths_to_bind.add("go.sum")
            elif executable == "python" and (root / "pyproject.toml").is_file():
                paths_to_bind.add("pyproject.toml")
                for name in ("uv.lock", "poetry.lock", "pdm.lock", "requirements.txt"):
                    if (root / name).is_file():
                        paths_to_bind.add(name)
            elif executable == "make":
                paths_to_bind.add("Makefile")
                fd = os.open(root / "Makefile", os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
                try:
                    validate_single_link_regular(fd, "quality-gate Makefile", require_owner=False)
                    with os.fdopen(fd, "r", encoding="utf-8") as handle:
                        fd = -1
                        text = handle.read(1024 * 1024)
                finally:
                    if fd >= 0:
                        os.close(fd)
                for match in re.finditer(r"(?m)^\s*-?include\s+([^#\n]+)", text):
                    for included in match.group(1).split():
                        validate_project_relative_path(included, "Makefile include")
                        paths_to_bind.add(included)
    return [safe_project_file(root, path, "quality-gate input") for path in sorted(paths_to_bind)]


def existing_text_for_manifest(path: pathlib.Path) -> str:
    if not path.exists() and not path.is_symlink():
        return ""
    if path.is_symlink() or not path.is_file():
        return ""
    fd = open_single_link_regular(path, require_owner=False)
    with os.fdopen(fd, "r", encoding="utf-8") as handle:
        return handle.read(1024 * 1024)


def validated_adoption_inputs(root: pathlib.Path, args: argparse.Namespace
                              ) -> tuple[str, dict[str, Any], dict[str, Any], dict[str, str]]:
    report = ensure_english_artifact(pathlib.Path(args.report), "HARNESS_ADOPTION_REPORT")
    analyst, analyst_hash = lifecycle_report_document(pathlib.Path(args.analyst_report), "analyst")
    auditor, auditor_hash = lifecycle_report_document(pathlib.Path(args.auditor_report), "auditor")
    if analyst.get("verdict") != "PASS" or auditor.get("verdict") != "PASS":
        raise HarnessError("Architecture Analyst and independent Auditor must both pass")
    for argv in analyst["quality_gates"]:
        validate_gate_argv(root, list(argv))
    return report, analyst, auditor, {"analyst_report": analyst_hash,
                                      "auditor_report": auditor_hash,
                                      "adoption_report": hashlib.sha256(report.encode("utf-8")).hexdigest()}


def build_adoption_plan(root: pathlib.Path, report: str, analyst: dict[str, Any],
                        input_hashes: dict[str, str]) -> dict[str, Any]:
    identity = repository_identity(root)
    context_records = []
    for value in analyst["context_files"]:
        if pathlib.PurePosixPath(value).name.startswith(".env") or SECRET_NAMES.search(value):
            raise HarnessError("context files must not include credential-shaped paths")
        context_records.append(safe_project_file(root, value, "context file"))
    protected_records = [safe_project_path(root, value, "protected path")
                         for value in analyst["protected_paths"]]
    facts = detect_project(root)
    facts["context"] = [record["path"] for record in context_records]
    facts["validated_protected_paths"] = [record["path"] for record in protected_records]
    gates = derived_gate_commands(root, facts)
    gate_inputs = gate_input_records(root, gates)
    config = render_config(root, facts)
    if tomllib is None:
        raise HarnessError("Python 3.11+ is required")
    parsed_config = tomllib.loads(config)
    configured_protected_paths = list(parsed_config.get("protected_paths", []))
    old_ignore = existing_text_for_manifest(root / ".gitignore")
    ignore_entry = "/.harness/runtime/"
    ignore = old_ignore
    if ignore_entry not in {line.strip() for line in old_ignore.splitlines()}:
        ignore += ("" if not ignore or ignore.endswith("\n") else "\n") + ignore_entry + "\n"
    normalized_report = normalize_adoption_report(report)
    bindings = {
        "analyst_report": input_hashes["analyst_report"],
        "auditor_report": input_hashes["auditor_report"],
        "normalized_adoption_report": hashlib.sha256(normalized_report.encode("utf-8")).hexdigest(),
        "generated_config": hashlib.sha256(config.encode("utf-8")).hexdigest(),
        "protected_paths": sha256_value(configured_protected_paths),
        "context_files": sha256_value(context_records),
        "quality_gates": sha256_value(gates),
        "quality_gate_inputs": sha256_value(gate_inputs),
    }
    stable = {"lifecycle_version": LIFECYCLE_VERSION, "repository": identity,
              "bindings": bindings, "protected_records": protected_records,
              "configured_protected_paths": configured_protected_paths,
              "context_records": context_records, "quality_gates": gates,
              "quality_gate_inputs": gate_inputs}
    generation = sha256_value(stable)[:32]
    timestamp_result = run_capture(["git", "show", "-s", "--format=%cI", "HEAD"], cwd=root)
    generated_at = timestamp_result.stdout.strip() if timestamp_result.returncode == 0 else "1970-01-01T00:00:00+00:00"
    provisional = {**stable, "generation_id": generation, "generated_at": generated_at,
                   "config": config, "gitignore": ignore,
                   "approval_block": adoption_approval_block(gates)}
    public, trusted = adoption_desired_files(root, provisional, report, analyst, generation)
    operations = [mutation_entry(root, ".harness/", None, directory=True, desired_mode=0o755),
                  mutation_entry(root, ".harness/runtime/", None, directory=True, desired_mode=0o755),
                  mutation_entry(root, "@git/harness-control/", None, directory=True, desired_mode=0o700)]
    operations.extend(mutation_entry(root, path, content, desired_mode=0o644)
                      for path, content in public.items())
    operations.extend(mutation_entry(root, f"@git/harness-control/{path}", content, desired_mode=0o600)
                      for path, content in trusted.items())
    for entry in operations:
        entry["repository_id"] = identity["repository_id"]
        entry["repository_head"] = identity["head"]
    core = {"lifecycle_version": LIFECYCLE_VERSION, "repository": identity,
            "bindings": bindings, "protected_records": protected_records,
            "configured_protected_paths": configured_protected_paths,
            "context_records": context_records, "quality_gates": gates,
            "quality_gate_inputs": gate_inputs, "generation_id": generation,
            "generated_at": generated_at, "mutation_manifest": operations}
    plan_hash = sha256_value(core)
    block = provisional["approval_block"]
    return {**core, "canonical_manifest": core, "plan_sha256": plan_hash, "approval_block": block,
            "operations": operations, "config": config, "gitignore": ignore}


def assess_project(args: argparse.Namespace) -> None:
    root = pathlib.Path.cwd().resolve()
    detection = lifecycle_detection(root)
    if detection["classification"] != "GIT_WITHOUT_HARNESS":
        raise HarnessError("assess requires a Git repository without a Harness")
    facts = detect_project(root)
    reports: dict[str, Any] = {}
    if args.analyst_report or args.auditor_report:
        if not args.analyst_report or not args.auditor_report:
            raise HarnessError("both analyst and auditor reports are required")
        reports["analyst"] = lifecycle_report(pathlib.Path(args.analyst_report), "analyst")
        reports["auditor"] = lifecycle_report(pathlib.Path(args.auditor_report), "auditor")
    result = {"mode": "BROWNFIELD_ADOPTION", "read_only": True,
              "dirty_worktree": detection["dirty_worktree"], "project": facts,
              "reports": reports}
    if args.json:
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    else:
        language = detect_operator_language(args.operator_input, args.operator_language)
        emit("assess", "ok", mode=result["mode"], read_only=True,
             dirty_worktree=result["dirty_worktree"],
             operator_message=operator_message("assessment_ready", language))


def render_project_doc(title: str, body: str) -> str:
    return f"# {title}\n\n{body.strip()}\n"


def write_lifecycle_state(root: pathlib.Path, workflow: str, source: str) -> None:
    p = paths(root)
    value = {"lifecycle_version": LIFECYCLE_VERSION, "lifecycle_state": workflow,
             "source": source, "updated_at": utc_now()}
    atomic_json(p["trusted"] / "lifecycle.json", value)
    atomic_runtime_json(p["base"] / "lifecycle.json", value)


def build_bootstrap_plan(root: pathlib.Path, brief: str) -> dict[str, Any]:
    defaults = {
        "PROJECT_BRIEF.md": brief.rstrip() + "\n",
        "README.md": render_project_doc(root.name, "See `PROJECT_BRIEF.md` for the approved product definition."),
        "AGENTS.md": render_project_doc("Engineering Instructions", "Use English for engineering artifacts, code comments, identifiers, plans, reports, and commits. Preserve approved scope and protected paths."),
        "ARCHITECTURE.md": render_project_doc("Architecture", "Architecture is pending the approved initial scaffold."),
    }
    old_ignore = existing_text_for_manifest(root / ".gitignore")
    ignore = old_ignore
    if "/.harness/runtime/" not in {line.strip() for line in old_ignore.splitlines()}:
        ignore += ("" if not ignore or ignore.endswith("\n") else "\n") + "/.harness/runtime/\n"
    facts = detect_project(root)
    config = render_config(root, facts)
    state = {"state_version": 1, "state_revision": 0, "harness_version": HARNESS_VERSION,
             "workflow_state": "STAGE_DISCUSSION", "stage_id": None, "stage_title": None,
             "slice_id": None, "attempt": 0, "gates_passed": False, "review_passed": False,
             "gate_level": None, "validated_worktree": None, "worker": None, "owner": None,
             "recent_transitions": []}
    lifecycle = {"lifecycle_version": LIFECYCLE_VERSION, "lifecycle_state": "SCAFFOLD_PENDING",
                 "source": "GREENFIELD_BOOTSTRAP"}
    project_state = (f"# Project State\n\nProject: {root.name}\n\n"
                     "## Current status\n\nThe approved bootstrap scaffold is pending baseline validation.\n")
    current_stage = ("# Current Stage\n\nNo Stage has been approved. Discuss the baseline "
                     "validation Stage and Slices with the operator first.\n")
    public = {name: content.encode("utf-8") for name, content in defaults.items()
              if name == "PROJECT_BRIEF.md" or not (root / name).exists()}
    public.update({".gitignore": ignore.encode("utf-8"), ".harness/config.toml": config.encode("utf-8"),
                   ".harness/state.json": (json.dumps(state, indent=2, sort_keys=True) + "\n").encode(),
                   ".harness/PROJECT_STATE.md": project_state.encode(),
                   ".harness/CURRENT_STAGE.md": current_stage.encode(),
                   ".harness/lifecycle.json": (json.dumps(lifecycle, indent=2, sort_keys=True) + "\n").encode()})
    trusted = {"config.toml": public[".harness/config.toml"], "state.json": public[".harness/state.json"],
               "CURRENT_STAGE.md": public[".harness/CURRENT_STAGE.md"],
               "lifecycle.json": public[".harness/lifecycle.json"]}
    operations = [mutation_entry(root, ".git/", None, directory=True, desired_mode=0o755),
                  mutation_entry(root, ".harness/", None, directory=True, desired_mode=0o755),
                  mutation_entry(root, ".harness/runtime/", None, directory=True, desired_mode=0o755),
                  {"path": "@git/harness-control/", "action": "CREATE", "operation": "CREATE",
                   "prior_exists": False, "prior_sha256": None, "prior_mode": None,
                   "desired_sha256": None, "desired_mode": 0o700}]
    operations.extend(mutation_entry(root, path, content, desired_mode=0o644)
                      for path, content in public.items())
    for name in defaults:
        if name not in public:
            target = root / name
            desired = b""
            desired_mode = None
            if target.is_file() and not target.is_symlink():
                fd = open_single_link_regular(target, require_owner=False)
                with os.fdopen(fd, "rb") as handle:
                    desired = handle.read()
                desired_mode = stat.S_IMODE(target.stat(follow_symlinks=False).st_mode)
            operations.append(mutation_entry(root, name, desired, desired_mode=desired_mode))
    operations.extend({"path": f"@git/harness-control/{path}", "action": "CREATE", "operation": "CREATE",
                       "prior_exists": False, "prior_sha256": None, "prior_mode": None,
                       "desired_sha256": hashlib.sha256(content).hexdigest(), "desired_mode": 0o600}
                      for path, content in trusted.items())
    identity = {"repository_id": hashlib.sha256(str(root.resolve()).encode()).hexdigest(),
                "root": str(root.resolve()), "git_dir": None, "head": None}
    for entry in operations:
        entry["repository_id"] = identity["repository_id"]
        entry["repository_head"] = identity["head"]
    core = {"mode": "GREENFIELD_BOOTSTRAP", "repository": identity,
            "brief_sha256": hashlib.sha256(brief.encode("utf-8")).hexdigest(),
            "mutation_manifest": operations}
    return {"plan_sha256": sha256_value(core), "canonical_manifest": core, "operations": operations,
            "defaults": defaults, "gitignore": ignore, "public_files": public,
            "trusted_files": trusted, "plan_core": core}


def bootstrap_project(args: argparse.Namespace) -> None:
    root = pathlib.Path.cwd().resolve()
    validate_engineering_name(root.name, "project directory name")
    detection = lifecycle_detection(root)
    if detection["mode"] != "GREENFIELD_BOOTSTRAP":
        raise HarnessError("bootstrap requires an empty or new non-Harness directory")
    brief_path = pathlib.Path(args.brief).resolve()
    brief = ensure_english_artifact(brief_path, "PROJECT_BRIEF")
    plan = build_bootstrap_plan(root, brief)
    if args.dry_run:
        emit("bootstrap", "dry-run", plan_sha256=plan["plan_sha256"],
             manifest=plan["canonical_manifest"], operations=plan["operations"])
        return
    if any(entry["action"] == "REJECT" for entry in plan["operations"]):
        raise HarnessError("bootstrap rejected by the approved mutation manifest")
    if not args.approved:
        language = detect_operator_language(args.operator_input, args.operator_language)
        raise HarnessError(operator_message("approval_required", language))
    if args.approved_plan_hash != plan["plan_sha256"]:
        raise HarnessError("approved bootstrap plan hash does not match the current dry-run manifest")
    if not (root / ".git").exists():
        cp = run_capture(["git", "init", "-b", "main"], cwd=root)
        if cp.returncode != 0:
            raise HarnessError(f"git init failed: {concise(cp.stdout, 400)}")
    git_dir = pathlib.Path(run_capture(["git", "rev-parse", "--absolute-git-dir"], cwd=root).stdout.strip())
    (root / ".harness/runtime").mkdir(parents=True, exist_ok=True)
    (git_dir / "harness-control").mkdir(parents=True, exist_ok=True, mode=0o700)
    for relative, content in plan["public_files"].items():
        atomic_write(root / relative, content.decode("utf-8"), mode=0o644)
    for relative, content in plan["trusted_files"].items():
        atomic_write(git_dir / "harness-control" / relative, content.decode("utf-8"), mode=0o600)
    emit("bootstrap", "ok", lifecycle_state="SCAFFOLD_PENDING")


def inject_adoption_approval(report: str, block: str) -> str:
    pattern = (r"<!--\s*harness-adoption-approval:start\s*-->.*?"
               r"<!--\s*harness-adoption-approval:end\s*-->")
    if re.search(pattern, report, flags=re.DOTALL | re.IGNORECASE):
        return re.sub(pattern, block, report, flags=re.DOTALL | re.IGNORECASE).rstrip() + "\n"
    return report.rstrip() + "\n\n" + block + "\n"


def adoption_desired_files(root: pathlib.Path, plan: dict[str, Any], report: str,
                           analyst: dict[str, Any], generation: str) -> tuple[dict[str, bytes], dict[str, bytes]]:
    now = plan["generated_at"]
    final_report = inject_adoption_approval(report, plan["approval_block"])
    bindings = {**plan["bindings"],
                "adoption_report": hashlib.sha256(final_report.encode("utf-8")).hexdigest()}
    lifecycle = {"lifecycle_version": LIFECYCLE_VERSION,
                 "lifecycle_state": "ADOPTION_VALIDATING", "source": "BROWNFIELD_ADOPTION",
                 "generation_id": generation, "repository": plan["repository"],
                 "bindings": bindings, "protected_paths": plan["configured_protected_paths"],
                 "context_files": plan["context_records"], "quality_gates": plan["quality_gates"],
                 "adoption_constraints": analyst["adoption_constraints"], "updated_at": now}
    validate_machine_language(lifecycle)
    state = {"state_version": 1, "state_revision": 0, "harness_version": HARNESS_VERSION,
             "workflow_state": "STAGE_DISCUSSION", "stage_id": None, "stage_title": None,
             "slice_id": None, "attempt": 0, "gates_passed": False, "review_passed": False,
             "gate_level": None, "validated_worktree": None, "worker": None, "owner": None,
             "created_at": now, "updated_at": now, "recent_transitions": []}
    project_state = (f"# Project State\n\nProject: {root.name}\n\nInitialized: {now}\n\n"
                     "## Current status\n\nHarness adoption is validating; no Stage is approved.\n")
    current_stage = ("# Current Stage\n\nNo Stage has been approved. Discuss the baseline "
                     "validation Stage and Slices with the operator first.\n")
    public = {
        "HARNESS_ADOPTION_REPORT.md": final_report.encode("utf-8"),
        ".gitignore": plan["gitignore"].encode("utf-8"),
        ".harness/config.toml": plan["config"].encode("utf-8"),
        ".harness/state.json": (json.dumps(state, indent=2, sort_keys=True) + "\n").encode("utf-8"),
        ".harness/PROJECT_STATE.md": project_state.encode("utf-8"),
        ".harness/CURRENT_STAGE.md": current_stage.encode("utf-8"),
        ".harness/lifecycle.json": (json.dumps(lifecycle, indent=2, sort_keys=True) + "\n").encode("utf-8"),
    }
    trusted = {
        "config.toml": public[".harness/config.toml"],
        "state.json": public[".harness/state.json"],
        "CURRENT_STAGE.md": public[".harness/CURRENT_STAGE.md"],
        "lifecycle.json": public[".harness/lifecycle.json"],
    }
    return public, trusted


def adoption_fault_phases(journal: dict[str, Any]) -> tuple[str, ...]:
    dynamic = []
    for item in journal.get("files", []):
        dynamic.extend((f"stage_file:{item['area']}:{item['path']}",
                        f"install_file:{item['area']}:{item['path']}"))
    dynamic.extend(("install_directory:.harness", "install_directory:.harness/runtime",
                    "install_directory:@git/harness-control", *ACTIVATION_WRITE_PHASES))
    return tuple(dict.fromkeys((*ADOPTION_JOURNAL_PHASES, *dynamic)))


def save_adoption_journal(path: pathlib.Path, journal: dict[str, Any], phase: str,
                          *, expected_revision: int | None = None,
                          expected_digest: str | None = None) -> None:
    if phase not in adoption_fault_phases(journal):
        raise HarnessError(f"unknown adoption journal durability phase: {phase}")
    if path.exists():
        current = load_json(path)
        current_revision = int(current.get("journal_revision", 0))
        required_revision = (int(journal.get("journal_revision", 0))
                             if expected_revision is None else expected_revision)
        if current_revision != required_revision:
            raise HarnessError("adoption journal CAS revision conflict; reload before writing")
        if expected_digest is not None and sha256_value(current) != expected_digest:
            raise HarnessError("adoption journal CAS content conflict; reload before writing")
    else:
        current_revision = -1
        required_revision = (-1 if expected_revision is None else expected_revision)
        if required_revision != -1:
            raise HarnessError("adoption journal CAS expected an existing journal")
    journal["journal_revision"] = current_revision + 1
    journal["updated_at"] = utc_now()
    journal["last_durability_phase"] = phase
    validate_machine_language(journal)
    atomic_json(path, journal)
    if (os.environ.get("HARNESS_ADOPTION_FAULT_AFTER") == phase or
            os.environ.get("HARNESS_ACTIVATION_FAULT_AFTER") == phase):
        raise HarnessError(f"fault injection after adoption durability phase: {phase}")


def mark_adoption_interrupted(root: pathlib.Path, journal_path: pathlib.Path,
                              journal: dict[str, Any], error: str) -> None:
    journal["lifecycle_state"] = "ADOPTION_INTERRUPTED"
    journal["last_error"] = concise(error, 600)
    save_adoption_journal(journal_path, journal, "adoption_interrupted")


def prepare_adoption_backup(root: pathlib.Path, journal_path: pathlib.Path,
                            journal: dict[str, Any]) -> None:
    backup_root = pathlib.Path(journal["backup_root"])
    backup_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(backup_root, 0o700)
    metadata: list[dict[str, Any]] = []
    for entry in journal["plan"]["mutation_manifest"]:
        if entry["path"].endswith("/") or entry["operation"] not in {"CREATE", "MODIFY"}:
            continue
        record = {key: entry[key] for key in ("path", "prior_exists", "prior_sha256",
                                               "prior_mode", "desired_sha256", "desired_mode")}
        if entry["prior_exists"]:
            target = mutation_target(root, entry["path"])
            fd = open_single_link_regular(target, require_owner=False)
            with os.fdopen(fd, "rb") as handle:
                content = handle.read()
            if hashlib.sha256(content).hexdigest() != entry["prior_sha256"]:
                raise HarnessError(f"adoption backup CAS mismatch: {entry['path']}")
            backup = backup_root / entry["path"].replace("@git/", "git/")
            atomic_write(backup, content.decode("utf-8"), mode=0o600)
            record["backup_path"] = str(backup)
        metadata.append(record)
    journal["backups"] = metadata
    journal["backup_binding"] = sha256_value({"repository": journal["repository"],
                                               "generation_id": journal["generation_id"],
                                               "plan_sha256": journal["plan_sha256"],
                                               "backups": metadata})
    save_adoption_journal(journal_path, journal, "backup_complete")


class RollbackFileState(NamedTuple):
    exists: bool
    device: int | None = None
    inode: int | None = None
    digest: str | None = None
    mode: int | None = None
    object_type: str | None = None


class RollbackAction(NamedTuple):
    path: str
    target: pathlib.Path
    prior_exists: bool
    prior_sha256: str | None
    prior_mode: int | None
    desired_sha256: str
    desired_mode: int
    backup_content: bytes | None
    backup_state: RollbackFileState | None
    expected_current: RollbackFileState
    operation: str
    temporary_name: str | None
    archive_name: str | None


class RollbackDirectoryAction(NamedTuple):
    path: str
    target: pathlib.Path
    prior_exists: bool
    prior_mode: int | None
    expected_device: int | None
    expected_inode: int | None
    archive_name: str | None


class RollbackExecutionPlan(NamedTuple):
    generation_id: str
    plan_sha256: str
    backup_binding: str
    execution_binding: str
    actions: tuple[RollbackAction, ...]
    directory_actions: tuple[RollbackDirectoryAction, ...]
    source_journal_revision: int
    source_journal_digest: str
    source_lifecycle_state: str
    archive_relative_root: str


def snapshot_rollback_file(path: pathlib.Path, label: str) -> tuple[bytes, RollbackFileState] | None:
    try:
        path.lstat()
    except FileNotFoundError:
        return None
    try:
        fd = open_single_link_regular(path, require_owner=False)
    except HarnessError as exc:
        raise HarnessError(f"{label} is unsafe: {type(exc).__name__}: {exc}") from exc
    with os.fdopen(fd, "rb") as handle:
        info = os.fstat(handle.fileno())
        content = handle.read()
    state = RollbackFileState(True, info.st_dev, info.st_ino,
                              hashlib.sha256(content).hexdigest(),
                              stat.S_IMODE(info.st_mode), "file")
    return content, state


def read_rollback_file(path: pathlib.Path, label: str) -> tuple[bytes, int] | None:
    value = snapshot_rollback_file(path, label)
    if value is None:
        return None
    return value[0], int(value[1].mode)


def validated_adoption_backup(record: dict[str, Any]) -> tuple[bytes, RollbackFileState]:
    raw_path = record.get("backup_path")
    if not isinstance(raw_path, str) or not raw_path:
        raise HarnessError(f"adoption backup is missing or unsafe: {record['path']}")
    backup = pathlib.Path(raw_path)
    try:
        value = snapshot_rollback_file(backup, "adoption backup")
    except HarnessError as exc:
        raise HarnessError(f"adoption backup is missing or unsafe: {record['path']}: {exc}") from exc
    if value is None:
        raise HarnessError(f"adoption backup is missing or unsafe: {record['path']}")
    content, state = value
    if state.digest != record["prior_sha256"]:
        raise HarnessError(f"adoption backup digest mismatch: {record['path']}")
    if state.mode != 0o600:
        raise HarnessError(f"adoption backup mode mismatch: {record['path']}")
    return content, state


def validate_rollback_journal_bindings(root: pathlib.Path, journal: dict[str, Any]) -> None:
    if (not isinstance(journal.get("repository"), dict) or
            not isinstance(journal.get("plan"), dict) or
            not isinstance(journal.get("plan_core"), dict) or
            not isinstance(journal["plan"].get("mutation_manifest"), list)):
        raise HarnessError("adoption rollback journal structure is malformed")
    if journal.get("repository") != repository_identity(root):
        raise HarnessError("rollback refused because repository identity or HEAD changed")
    generation = journal.get("generation_id")
    if (not isinstance(generation, str) or not re.fullmatch(r"[0-9a-f]{32}", generation) or
            journal.get("plan", {}).get("generation_id") != generation or
            journal.get("plan_core", {}).get("generation_id") != generation):
        raise HarnessError("adoption rollback generation binding mismatch")
    plan_sha256 = journal.get("plan_sha256")
    if (not isinstance(plan_sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", plan_sha256) or
            plan_sha256 != sha256_value(journal.get("plan_core")) or
            journal.get("plan", {}).get("plan_sha256") != plan_sha256):
        raise HarnessError("adoption rollback plan binding mismatch")
    records = journal.get("backups")
    if not isinstance(records, list):
        raise HarnessError("adoption rollback records are malformed")
    expected_binding = sha256_value({"repository": journal["repository"],
                                     "generation_id": generation,
                                     "plan_sha256": plan_sha256,
                                     "backups": records})
    if expected_binding != journal.get("backup_binding"):
        raise HarnessError("adoption backup binding is missing or damaged")
    manifest = [entry for entry in journal["plan"]["mutation_manifest"]
                if not entry["path"].endswith("/") and entry["operation"] in {"CREATE", "MODIFY"}]
    if len(manifest) != len(records):
        raise HarnessError("adoption rollback record count mismatch")
    keys = ("path", "prior_exists", "prior_sha256", "prior_mode",
            "desired_sha256", "desired_mode")
    backup_root = pathlib.Path(journal.get("backup_root", ""))
    expected_root = pathlib.Path(journal["repository"]["git_dir"]) / f"harness-adoption-backup-{generation}"
    if backup_root != expected_root:
        raise HarnessError("adoption backup root binding mismatch")
    for entry, record in zip(manifest, records):
        if not isinstance(record, dict) or any(record.get(key) != entry.get(key) for key in keys):
            raise HarnessError("adoption rollback record does not match mutation manifest")
        if record["prior_exists"]:
            expected_path = backup_root / record["path"].replace("@git/", "git/")
            if pathlib.Path(record.get("backup_path", "")) != expected_path:
                raise HarnessError(f"adoption backup path binding mismatch: {record['path']}")


def validate_rollback_record_metadata(record: dict[str, Any]) -> None:
    if not isinstance(record.get("path"), str):
        raise HarnessError("adoption rollback record path is malformed")
    raw_path = record["path"].removeprefix("@git/")
    path = pathlib.PurePosixPath(raw_path)
    if (not raw_path or path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts)
            or "\\" in raw_path or any(character in raw_path for character in "*?[")):
        raise HarnessError("adoption rollback record path is unsafe")
    if not re.fullmatch(r"[A-Za-z0-9._/-]+", raw_path):
        raise HarnessError("adoption rollback record path uses unsafe characters")
    if not isinstance(record.get("prior_exists"), bool):
        raise HarnessError(f"adoption rollback existence metadata is malformed: {record['path']}")
    for name in ("desired_sha256",):
        if not isinstance(record.get(name), str) or not re.fullmatch(r"[0-9a-f]{64}", record[name]):
            raise HarnessError(f"adoption rollback digest metadata is malformed: {record['path']}")
    if record["prior_exists"]:
        if (not isinstance(record.get("prior_sha256"), str) or                not re.fullmatch(r"[0-9a-f]{64}", record["prior_sha256"])):
            raise HarnessError(f"adoption rollback prior digest is malformed: {record['path']}")
        if not isinstance(record.get("prior_mode"), int) or not 0 <= record["prior_mode"] <= 0o7777:
            raise HarnessError(f"adoption rollback prior mode is malformed: {record['path']}")
    if not isinstance(record.get("desired_mode"), int) or not 0 <= record["desired_mode"] <= 0o7777:
        raise HarnessError(f"adoption rollback desired mode is malformed: {record['path']}")


def rollback_plan_value(action: RollbackAction) -> dict[str, Any]:
    return {"path": action.path, "target": str(action.target), "prior_exists": action.prior_exists,
            "prior_sha256": action.prior_sha256, "prior_mode": action.prior_mode,
            "desired_sha256": action.desired_sha256, "desired_mode": action.desired_mode,
            "backup": None if action.backup_state is None else action.backup_state._asdict(),
            "expected_current": action.expected_current._asdict(),
            "operation": action.operation, "temporary_name": action.temporary_name,
            "archive_name": action.archive_name}


def rollback_directory_plan_value(action: RollbackDirectoryAction) -> dict[str, Any]:
    return {"path": action.path, "target": str(action.target),
            "prior_exists": action.prior_exists, "prior_mode": action.prior_mode,
            "expected_device": action.expected_device, "expected_inode": action.expected_inode,
            "archive_name": action.archive_name}


def build_rollback_execution_plan(root: pathlib.Path,
                                  journal: dict[str, Any]) -> RollbackExecutionPlan:
    validate_rollback_journal_bindings(root, journal)
    conflicts: list[str] = []
    actions: list[RollbackAction] = []
    for control_dir in (root / ".harness",
                        pathlib.Path(journal["repository"]["git_dir"]) / "harness-control"):
        if control_dir.is_symlink():
            conflicts.append(str(control_dir))
    for index, record in enumerate(journal["backups"]):
        try:
            validate_rollback_record_metadata(record)
            target = mutation_target(root, record["path"])
            current_value = snapshot_rollback_file(target, "rollback target")
            current_state = (RollbackFileState(False) if current_value is None
                             else current_value[1])
            backup_content: bytes | None = None
            backup_state: RollbackFileState | None = None
            if record["prior_exists"]:
                backup_content, backup_state = validated_adoption_backup(record)
                if not current_state.exists:
                    raise HarnessError("expected rollback target is missing")
                if current_state.digest == record["prior_sha256"]:
                    operation = ("already" if current_state.mode == record["prior_mode"]
                                 else "restore")
                elif current_state.digest == record["desired_sha256"]:
                    operation = "restore"
                else:
                    raise HarnessError("rollback target has an operator-edit conflict")
            else:
                if not current_state.exists:
                    operation = "already"
                elif (current_state.digest == record["desired_sha256"] and
                      current_state.mode == record["desired_mode"]):
                    operation = "remove"
                else:
                    raise HarnessError("rollback target has an operator-edit conflict")
            temporary_name = (None if operation == "already" else
                              f".{target.name}.rollback-{journal['generation_id']}-{index:04d}")
            archive_name = (None if operation == "already" else
                            f"file-{index:04d}-r{int(journal.get('journal_revision', 0)):08d}")
            if temporary_name is not None:
                temporary = target.parent / temporary_name
                if temporary.exists() or temporary.is_symlink():
                    raise HarnessError("rollback temporary path unexpectedly exists")
            actions.append(RollbackAction(
                record["path"], target, record["prior_exists"], record.get("prior_sha256"),
                record.get("prior_mode"), record["desired_sha256"], record["desired_mode"],
                backup_content, backup_state, current_state, operation, temporary_name,
                archive_name,
            ))
        except HarnessError as exc:
            conflicts.append(f"{record.get('path', '<unknown>')}: {exc}")
    if conflicts:
        raise HarnessError(f"rollback preflight requires operator decision: {conflicts}")
    directory_actions: list[RollbackDirectoryAction] = []
    directory_entries = [entry for entry in journal["plan"]["mutation_manifest"]
                         if entry["path"].endswith("/")]
    for index, entry in enumerate(directory_entries):
        target = mutation_target(root, entry["path"])
        try:
            info = target.lstat()
        except FileNotFoundError:
            info = None
        if info is not None and (target.is_symlink() or not stat.S_ISDIR(info.st_mode)):
            raise HarnessError(f"rollback directory target is unsafe: {entry['path']}")
        if entry["prior_exists"] and info is None:
            raise HarnessError(f"rollback prior directory is missing: {entry['path']}")
        if (entry["prior_exists"] and info is not None and
                stat.S_IMODE(info.st_mode) != entry["prior_mode"]):
            raise HarnessError(f"rollback prior directory mode changed: {entry['path']}")
        archive_name = None
        if (not entry["prior_exists"] and info is not None and
                entry["path"] != "@git/harness-control/"):
            archive_name = (f"directory-{index:04d}-"
                            f"r{int(journal.get('journal_revision', 0)):08d}")
        directory_actions.append(RollbackDirectoryAction(
            entry["path"], target, entry["prior_exists"], entry.get("prior_mode"),
            None if info is None else info.st_dev, None if info is None else info.st_ino,
            archive_name,
        ))
    for action in actions:
        if action.temporary_name is not None:
            temporary = action.target.parent / action.temporary_name
            if temporary.exists() or temporary.is_symlink():
                raise HarnessError(f"rollback preflight found an exact temporary artifact: {temporary}")
    values = tuple(rollback_plan_value(action) for action in actions)
    directory_values = tuple(rollback_directory_plan_value(action)
                             for action in directory_actions)
    source_digest = sha256_value(journal)
    archive_relative_root = f"rollback-archive/{journal['generation_id']}"
    execution_binding = sha256_value({"generation_id": journal["generation_id"],
                                      "plan_sha256": journal["plan_sha256"],
                                      "backup_binding": journal["backup_binding"],
                                      "source_journal_revision": journal.get("journal_revision", 0),
                                      "source_journal_digest": source_digest,
                                      "source_lifecycle_state": journal.get("lifecycle_state"),
                                      "archive_relative_root": archive_relative_root,
                                      "actions": values, "directory_actions": directory_values})
    return RollbackExecutionPlan(journal["generation_id"], journal["plan_sha256"],
                                 journal["backup_binding"], execution_binding, tuple(actions),
                                 tuple(directory_actions), int(journal.get("journal_revision", 0)),
                                 source_digest, str(journal.get("lifecycle_state")),
                                 archive_relative_root)


RENAME_NOREPLACE = 1
RENAME_EXCHANGE = 2


def linux_renameat2(directory_fd: int, old_name: str, new_name: str, flags: int) -> None:
    linux_renameat2_between(directory_fd, old_name, directory_fd, new_name, flags)


def linux_renameat2_between(old_directory_fd: int, old_name: str,
                            new_directory_fd: int, new_name: str, flags: int) -> None:
    if sys.platform != "linux":
        raise HarnessError("atomic rollback requires trusted-local Linux renameat2 support")
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise HarnessError("atomic rollback capability unavailable: renameat2")
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
                          ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    result = renameat2(old_directory_fd, os.fsencode(old_name), new_directory_fd,
                       os.fsencode(new_name), flags)
    if result == 0:
        return
    error = ctypes.get_errno()
    if error in {errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP, errno.EXDEV}:
        raise HarnessError(f"atomic rollback capability unavailable: renameat2 errno {error}")
    raise HarnessError(f"atomic rollback renameat2 failed: errno {error}")


def ensure_atomic_exchange_capability(action: RollbackAction) -> None:
    if action.operation == "already":
        return
    directory_fd = open_directory_nofollow(action.target.parent)
    try:
        linux_renameat2(directory_fd, action.target.name, action.target.name, RENAME_EXCHANGE)
        if action.operation == "remove":
            try:
                linux_renameat2(directory_fd, action.target.name, action.target.name,
                                RENAME_NOREPLACE)
            except HarnessError as exc:
                if f"errno {errno.EEXIST}" not in str(exc):  # EEXIST proves flag support.
                    raise
    finally:
        os.close(directory_fd)


def create_rollback_restoration(action: RollbackAction) -> RollbackFileState:
    if action.temporary_name is None or action.backup_content is None or action.prior_mode is None:
        raise HarnessError("rollback restoration plan is incomplete")
    directory_fd = open_directory_nofollow(action.target.parent)
    fd = -1
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(action.temporary_name, flags, 0o600, dir_fd=directory_fd)
        view = memoryview(action.backup_content)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fchmod(fd, action.prior_mode)
        os.fsync(fd)
        info = os.fstat(fd)
        state = RollbackFileState(True, info.st_dev, info.st_ino,
                                  hashlib.sha256(action.backup_content).hexdigest(),
                                  stat.S_IMODE(info.st_mode), "file")
        os.fsync(directory_fd)
        return state
    finally:
        if fd >= 0:
            os.close(fd)
        os.close(directory_fd)


def rollback_archive_root(root: pathlib.Path, plan: RollbackExecutionPlan) -> pathlib.Path:
    git_dir = pathlib.Path(repository_identity(root)["git_dir"])
    return git_dir / "harness-control" / plan.archive_relative_root


def ensure_rollback_archive(root: pathlib.Path,
                            plan: RollbackExecutionPlan) -> pathlib.Path:
    git_dir = pathlib.Path(repository_identity(root)["git_dir"])
    control = git_dir / "harness-control"
    archive_parent = control / "rollback-archive"
    archive = archive_parent / plan.generation_id
    for directory in (control, archive_parent, archive):
        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
            raise HarnessError("rollback archive control path is unsafe")
        directory.mkdir(mode=0o700, exist_ok=True)
        os.chmod(directory, 0o700)
    return archive


def snapshot_archive_object(path: pathlib.Path, label: str) -> RollbackFileState:
    try:
        info = path.lstat()
    except FileNotFoundError as exc:
        raise HarnessError(f"{label} is missing") from exc
    if path.is_symlink():
        raise HarnessError(f"{label} is a symlink")
    if stat.S_ISREG(info.st_mode):
        value = snapshot_rollback_file(path, label)
        if value is None:
            raise HarnessError(f"{label} is missing")
        return value[1]
    if stat.S_ISDIR(info.st_mode):
        entries = []
        for item in sorted(path.iterdir(), key=lambda candidate: candidate.name):
            child = item.lstat()
            entries.append({"name": item.name, "mode": child.st_mode,
                            "device": child.st_dev, "inode": child.st_ino})
        return RollbackFileState(True, info.st_dev, info.st_ino, sha256_value(entries),
                                 stat.S_IMODE(info.st_mode), "directory")
    raise HarnessError(f"{label} is not a regular file or directory")


def archive_record(action_path: str, archive_name: str, generation_id: str,
                   role: str, state: RollbackFileState) -> dict[str, Any]:
    return {"relative_name": archive_name, "source_path": action_path,
            "generation_id": generation_id, "role": role,
            "device": state.device, "inode": state.inode,
            "object_type": state.object_type, "sha256": state.digest,
            "mode": state.mode}


def move_object_to_rollback_archive(source_parent: pathlib.Path, source_name: str,
                                    archive_root: pathlib.Path, archive_name: str,
                                    action_path: str, generation_id: str,
                                    role: str) -> tuple[dict[str, Any], RollbackFileState]:
    source_fd = open_directory_nofollow(source_parent)
    archive_fd = open_directory_nofollow(archive_root)
    try:
        linux_renameat2_between(source_fd, source_name, archive_fd, archive_name,
                                RENAME_NOREPLACE)
        os.fsync(source_fd)
        os.fsync(archive_fd)
    finally:
        os.close(source_fd)
        os.close(archive_fd)
    state = snapshot_archive_object(archive_root / archive_name, "rollback archive object")
    return archive_record(action_path, archive_name, generation_id, role, state), state


class RollbackExecutionError(HarnessError):
    def __init__(self, message: str, records: tuple[dict[str, Any], ...] = ()):
        super().__init__(message)
        self.records = records


def execute_restore_action(action: RollbackAction, archive_root: pathlib.Path,
                           generation_id: str) -> dict[str, Any]:
    restoration_state = create_rollback_restoration(action)
    directory_fd = open_directory_nofollow(action.target.parent)
    try:
        try:
            linux_renameat2(directory_fd, action.temporary_name, action.target.name,
                            RENAME_EXCHANGE)
            os.fsync(directory_fd)
        except HarnessError as exc:
            record, _state = move_object_to_rollback_archive(
                action.target.parent, action.temporary_name, archive_root,
                action.archive_name, action.path, generation_id, "restoration")
            raise RollbackExecutionError(str(exc), (record,)) from exc
    finally:
        os.close(directory_fd)
    displaced = snapshot_rollback_file(action.target.parent / action.temporary_name,
                                       "displaced rollback target")
    installed = snapshot_rollback_file(action.target, "installed rollback restoration")
    if (displaced is None or displaced[1] != action.expected_current or
            installed is None or installed[1] != restoration_state):
        directory_fd = open_directory_nofollow(action.target.parent)
        try:
            linux_renameat2(directory_fd, action.temporary_name, action.target.name,
                            RENAME_EXCHANGE)
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
        record, _state = move_object_to_rollback_archive(
            action.target.parent, action.temporary_name, archive_root,
            action.archive_name, action.path, generation_id, "restoration")
        raise RollbackExecutionError(
            f"rollback displaced-object verification failed: {action.path}", (record,))
    record, archived_state = move_object_to_rollback_archive(
        action.target.parent, action.temporary_name, archive_root,
        action.archive_name, action.path, generation_id, "displaced")
    if archived_state != action.expected_current:
        raise RollbackExecutionError(
            f"rollback archived displaced object changed: {action.path}", (record,))
    return record


def restore_quarantined_action(action: RollbackAction) -> None:
    directory_fd = open_directory_nofollow(action.target.parent)
    try:
        linux_renameat2(directory_fd, action.temporary_name, action.target.name,
                        RENAME_NOREPLACE)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def execute_remove_action(action: RollbackAction, archive_root: pathlib.Path,
                          generation_id: str) -> dict[str, Any]:
    if action.temporary_name is None:
        raise HarnessError("rollback quarantine plan is incomplete")
    directory_fd = open_directory_nofollow(action.target.parent)
    try:
        linux_renameat2(directory_fd, action.target.name, action.temporary_name,
                        RENAME_NOREPLACE)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
    quarantined = snapshot_rollback_file(action.target.parent / action.temporary_name,
                                         "quarantined rollback target")
    if quarantined is None or quarantined[1] != action.expected_current:
        restore_quarantined_action(action)
        raise HarnessError(f"rollback quarantined-object verification failed: {action.path}")
    record, archived_state = move_object_to_rollback_archive(
        action.target.parent, action.temporary_name, archive_root,
        action.archive_name, action.path, generation_id, "quarantined")
    if archived_state != action.expected_current:
        raise RollbackExecutionError(
            f"rollback archived quarantine object changed: {action.path}", (record,))
    return record


def execute_rollback_action(action: RollbackAction, archive_root: pathlib.Path,
                            generation_id: str) -> dict[str, Any] | None:
    if action.operation == "already":
        return
    if action.operation == "restore":
        return execute_restore_action(action, archive_root, generation_id)
    if action.operation == "remove":
        return execute_remove_action(action, archive_root, generation_id)
    raise HarnessError(f"unknown rollback operation: {action.operation}")


def execute_rollback_directory_action(action: RollbackDirectoryAction,
                                      archive_root: pathlib.Path,
                                      generation_id: str) -> dict[str, Any] | None:
    if action.archive_name is None:
        return None
    try:
        info = action.target.lstat()
    except FileNotFoundError as exc:
        raise HarnessError(f"rollback directory disappeared: {action.path}") from exc
    if (action.target.is_symlink() or not stat.S_ISDIR(info.st_mode) or
            info.st_dev != action.expected_device or info.st_ino != action.expected_inode or
            any(action.target.iterdir())):
        raise HarnessError(f"rollback directory identity or contents changed: {action.path}")
    expected = RollbackFileState(True, info.st_dev, info.st_ino, sha256_value([]),
                                 stat.S_IMODE(info.st_mode), "directory")
    record, archived_state = move_object_to_rollback_archive(
        action.target.parent, action.target.name, archive_root, action.archive_name,
        action.path, generation_id, "directory")
    if archived_state != expected:
        raise RollbackExecutionError(
            f"rollback archived directory changed: {action.path}", (record,))
    return record


def clone_json_object(value: dict[str, Any]) -> dict[str, Any]:
    return json.loads(json.dumps(value, ensure_ascii=False))


def transition_rollback_executing(root: pathlib.Path, journal_path: pathlib.Path,
                                  plan: RollbackExecutionPlan) -> dict[str, Any]:
    current = load_json(journal_path)
    validate_rollback_journal_bindings(root, current)
    if (int(current.get("journal_revision", 0)) != plan.source_journal_revision or
            sha256_value(current) != plan.source_journal_digest or
            current.get("lifecycle_state") != plan.source_lifecycle_state or
            current.get("generation_id") != plan.generation_id or
            current.get("plan_sha256") != plan.plan_sha256 or
            current.get("backup_binding") != plan.backup_binding):
        raise HarnessError("rollback journal CAS conflict before execution")
    updated = clone_json_object(current)
    archive = updated.get("rollback_archive")
    if archive is None:
        archive = {"generation_id": plan.generation_id,
                   "relative_root": plan.archive_relative_root,
                   "inventory": [], "inventory_sha256": sha256_value([]),
                   "gc_phase": "GC_NOT_STARTED"}
        updated["rollback_archive"] = archive
    if (archive.get("generation_id") != plan.generation_id or
            archive.get("relative_root") != plan.archive_relative_root or
            not isinstance(archive.get("inventory"), list)):
        raise HarnessError("rollback archive binding mismatch before execution")
    updated["lifecycle_state"] = "ROLLBACK_EXECUTING"
    updated["rollback_execution_plan_sha256"] = plan.execution_binding
    updated["rollback_source_revision"] = plan.source_journal_revision
    save_adoption_journal(journal_path, updated, "rollback_executing",
                          expected_revision=plan.source_journal_revision,
                          expected_digest=plan.source_journal_digest)
    return updated


def append_rollback_archive_record(journal_path: pathlib.Path,
                                   authoritative: dict[str, Any],
                                   record: dict[str, Any]) -> dict[str, Any]:
    current = load_json(journal_path)
    expected_digest = sha256_value(authoritative)
    if (int(current.get("journal_revision", 0)) !=
            int(authoritative.get("journal_revision", 0)) or
            sha256_value(current) != expected_digest or
            current.get("lifecycle_state") != "ROLLBACK_EXECUTING"):
        raise HarnessError("rollback archive journal CAS conflict")
    updated = clone_json_object(current)
    inventory = updated["rollback_archive"]["inventory"]
    if any(item.get("relative_name") == record["relative_name"] for item in inventory):
        raise HarnessError("rollback archive record already exists")
    inventory.append(record)
    updated["rollback_archive"]["inventory_sha256"] = sha256_value(inventory)
    save_adoption_journal(journal_path, updated, "rollback_archive_recorded",
                          expected_revision=int(current["journal_revision"]),
                          expected_digest=expected_digest)
    return updated


def archive_state_from_record(record: dict[str, Any]) -> RollbackFileState:
    return RollbackFileState(True, record.get("device"), record.get("inode"),
                             record.get("sha256"), record.get("mode"),
                             record.get("object_type"))


def verify_rollback_archive(root: pathlib.Path, journal: dict[str, Any],
                            plan: RollbackExecutionPlan) -> list[str]:
    conflicts: list[str] = []
    archive = journal.get("rollback_archive")
    if not isinstance(archive, dict) or not isinstance(archive.get("inventory"), list):
        return ["rollback archive inventory is missing"]
    if (archive.get("generation_id") != plan.generation_id or
            archive.get("relative_root") != plan.archive_relative_root):
        return ["rollback archive generation binding mismatch"]
    archive_root = rollback_archive_root(root, plan)
    inventory = archive["inventory"]
    names = [item.get("relative_name") for item in inventory]
    expected_names = {action.archive_name for action in plan.actions
                      if action.archive_name is not None}
    expected_names.update(action.archive_name for action in plan.directory_actions
                          if action.archive_name is not None)
    if not expected_names.issubset(set(names)):
        conflicts.append("rollback archive lacks an execution-plan object")
    if any(not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9._-]+", name)
           for name in names) or len(names) != len(set(names)):
        conflicts.append("rollback archive inventory names are malformed")
        return conflicts
    actual_names: set[str] = set()
    try:
        actual_names = {item.name for item in archive_root.iterdir()}
    except FileNotFoundError:
        if inventory:
            conflicts.append("rollback archive directory is missing")
    if actual_names != set(names):
        conflicts.append("rollback archive contains unjournaled or missing objects")
    for record in inventory:
        if record.get("generation_id") != plan.generation_id:
            conflicts.append(f"rollback archive generation mismatch: {record.get('relative_name')}")
            continue
        try:
            state = snapshot_archive_object(archive_root / record["relative_name"],
                                            "rollback archive object")
            if state != archive_state_from_record(record):
                conflicts.append(f"rollback archive object changed: {record['relative_name']}")
        except HarnessError as exc:
            conflicts.append(str(exc))
    return conflicts


def verify_adoption_rollback_state(root: pathlib.Path, journal: dict[str, Any],
                                   plan: RollbackExecutionPlan) -> list[str]:
    conflicts: list[str] = []
    try:
        validate_rollback_journal_bindings(root, journal)
        if (journal.get("rollback_execution_plan_sha256") != plan.execution_binding or
                journal.get("generation_id") != plan.generation_id or
                journal.get("plan_sha256") != plan.plan_sha256 or
                journal.get("backup_binding") != plan.backup_binding):
            raise HarnessError("rollback execution binding changed after preflight")
    except HarnessError as exc:
        conflicts.append(str(exc))
    for action in plan.actions:
        try:
            if action.prior_exists:
                record = next(item for item in journal["backups"] if item["path"] == action.path)
                _content, backup_state = validated_adoption_backup(record)
                if backup_state != action.backup_state:
                    conflicts.append(f"{action.path}: adoption backup identity changed")
            current = snapshot_rollback_file(action.target, "rollback target")
            if not action.prior_exists:
                if current is not None:
                    conflicts.append(action.path)
            elif current is None:
                conflicts.append(action.path)
            else:
                state = current[1]
                if state.digest != action.prior_sha256 or state.mode != action.prior_mode:
                    conflicts.append(action.path)
            if action.temporary_name is not None:
                temporary = action.target.parent / action.temporary_name
                if temporary.exists() or temporary.is_symlink():
                    conflicts.append(f"{action.path}: unarchived rollback temporary remains")
        except HarnessError as exc:
            conflicts.append(f"{action.path}: {exc}")
    for action in plan.directory_actions:
        try:
            info = action.target.lstat()
        except FileNotFoundError:
            if action.prior_exists:
                conflicts.append(f"rollback directory is missing: {action.path}")
            continue
        if action.path == "@git/harness-control/" and not action.prior_exists:
            if action.target.is_symlink() or not stat.S_ISDIR(info.st_mode):
                conflicts.append("rollback retained control directory is unsafe")
            continue
        if (not action.prior_exists or not stat.S_ISDIR(info.st_mode) or
                action.target.is_symlink() or stat.S_IMODE(info.st_mode) != action.prior_mode):
            conflicts.append(f"rollback directory state mismatch: {action.path}")
    conflicts.extend(verify_rollback_archive(root, journal, plan))
    return conflicts


def transition_rollback_checkpoint(journal_path: pathlib.Path,
                                   authoritative: dict[str, Any], error: str) -> dict[str, Any]:
    current = load_json(journal_path)
    expected_digest = sha256_value(authoritative)
    if (int(current.get("journal_revision", 0)) !=
            int(authoritative.get("journal_revision", 0)) or
            sha256_value(current) != expected_digest):
        raise HarnessError("rollback journal CAS conflict while recording checkpoint")
    updated = clone_json_object(current)
    updated["lifecycle_state"] = "HUMAN_CHECKPOINT"
    updated["rollback_conflicts"] = [concise(error, 600)]
    save_adoption_journal(journal_path, updated, "rollback_human_checkpoint",
                          expected_revision=int(current["journal_revision"]),
                          expected_digest=expected_digest)
    return updated


def rollback_adoption(root: pathlib.Path) -> None:
    """Restore project state while retaining journal-bound control-plane archives."""
    journal_path, _ = adoption_control(root)
    source_journal = load_json(journal_path)
    try:
        plan = build_rollback_execution_plan(root, source_journal)
    except (HarnessError, OSError, UnicodeError) as exc:
        p = paths(root)
        with state_lock(p):
            current = load_json(journal_path)
            if (int(current.get("journal_revision", 0)) ==
                    int(source_journal.get("journal_revision", 0)) and
                    sha256_value(current) == sha256_value(source_journal)):
                transition_rollback_checkpoint(journal_path, current, str(exc))
        if isinstance(exc, HarnessError):
            raise
        raise HarnessError(f"rollback preflight failed: {type(exc).__name__}") from exc
    p = paths(root)
    with state_lock(p):
        reloaded = load_json(journal_path)
        if (reloaded.get("lifecycle_state") == "ADOPTION_ROLLED_BACK" and
                reloaded.get("rollback_archive", {}).get("gc_phase") == "GC_DETACHED"):
            if (int(reloaded.get("journal_revision", 0)) != plan.source_journal_revision or
                    sha256_value(reloaded) != plan.source_journal_digest):
                raise HarnessError("rollback journal CAS conflict before idempotent completion")
            return
        authoritative = transition_rollback_executing(root, journal_path, plan)
        archive_root = ensure_rollback_archive(root, plan)
        try:
            for action in plan.actions:
                ensure_atomic_exchange_capability(action)
            for action in reversed(plan.actions):
                record = execute_rollback_action(action, archive_root, plan.generation_id)
                if record is not None:
                    authoritative = append_rollback_archive_record(
                        journal_path, authoritative, record)
            for action in sorted(plan.directory_actions,
                                 key=lambda item: len(item.target.parts), reverse=True):
                record = execute_rollback_directory_action(
                    action, archive_root, plan.generation_id)
                if record is not None:
                    authoritative = append_rollback_archive_record(
                        journal_path, authoritative, record)
        except (HarnessError, OSError, UnicodeError) as exc:
            if isinstance(exc, RollbackExecutionError):
                for record in exc.records:
                    authoritative = append_rollback_archive_record(
                        journal_path, authoritative, record)
            transition_rollback_checkpoint(journal_path, authoritative, str(exc))
            if isinstance(exc, HarnessError):
                raise
            raise HarnessError(f"atomic rollback operation failed: {type(exc).__name__}") from exc
        post_journal = load_json(journal_path)
        conflicts = verify_adoption_rollback_state(root, post_journal, plan)
        if conflicts:
            transition_rollback_checkpoint(journal_path, post_journal, str(conflicts))
            raise HarnessError(f"rollback verification requires operator decision: {conflicts}")
        completed = clone_json_object(post_journal)
        completed["lifecycle_state"] = "ADOPTION_ROLLED_BACK"
        completed["last_error"] = None
        completed["rollback_archive"]["project_state_restored"] = True
        completed["rollback_archive"]["inventory_sha256"] = sha256_value(
            completed["rollback_archive"]["inventory"])
        completed["rollback_archive"]["gc_phase"] = "GC_NOT_STARTED"
        save_adoption_journal(journal_path, completed, "rollback_complete",
                              expected_revision=int(post_journal["journal_revision"]),
                              expected_digest=sha256_value(post_journal))


class RollbackGCFault(HarnessError):
    """Deterministic crash boundary used to prove GC reconciliation."""


def rollback_gc_fault(point: str) -> None:
    requested = os.environ.get("HARNESS_ROLLBACK_GC_FAULT_AFTER")
    if requested == point:
        raise RollbackGCFault(f"fault injection after rollback GC boundary: {point}")


def gc_root_identity(path: pathlib.Path, label: str) -> dict[str, Any]:
    try:
        info = path.lstat()
    except FileNotFoundError as exc:
        raise HarnessError(f"{label} is missing") from exc
    if path.is_symlink() or not stat.S_ISDIR(info.st_mode):
        raise HarnessError(f"{label} is not a no-follow directory")
    return {"device": info.st_dev, "inode": info.st_ino,
            "object_type": "directory", "mode": stat.S_IMODE(info.st_mode)}


def gc_path_exists(path: pathlib.Path) -> bool:
    try:
        path.lstat()
        return True
    except FileNotFoundError:
        return False
    except NotADirectoryError as exc:
        raise HarnessError("rollback GC path parent is not a directory") from exc


def validate_gc_inventory(inventory: Any, generation: str) -> list[dict[str, Any]]:
    if not isinstance(inventory, list):
        raise HarnessError("rollback GC canonical inventory is missing")
    names: list[str] = []
    for record in inventory:
        if not isinstance(record, dict):
            raise HarnessError("rollback GC inventory record is malformed")
        name = record.get("relative_name")
        if (not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9._-]+", name) or
                record.get("generation_id") != generation or
                record.get("object_type") not in {"file", "directory"}):
            raise HarnessError("rollback GC inventory binding is malformed")
        names.append(name)
    if len(names) != len(set(names)):
        raise HarnessError("rollback GC inventory names are duplicated")
    return inventory


def verify_gc_inventory_root(root: pathlib.Path, inventory: list[dict[str, Any]],
                             *, allow_missing: bool) -> None:
    expected = {record["relative_name"]: record for record in inventory}
    try:
        actual = {item.name for item in root.iterdir()}
    except FileNotFoundError as exc:
        raise HarnessError("rollback GC root is missing") from exc
    unexpected = actual - set(expected)
    missing = set(expected) - actual
    if unexpected:
        raise HarnessError("rollback GC root contains unjournaled objects")
    if missing and not allow_missing:
        raise HarnessError("rollback GC root lacks journal-bound objects")
    for name in sorted(actual):
        state = snapshot_archive_object(root / name, "rollback GC inventory object")
        if state != archive_state_from_record(expected[name]):
            raise HarnessError(f"rollback GC inventory identity mismatch: {name}")


def verify_restored_project_for_gc(root: pathlib.Path, journal: dict[str, Any]) -> None:
    validate_rollback_journal_bindings(root, journal)
    conflicts: list[str] = []
    for record in journal.get("backups", []):
        try:
            target = mutation_target(root, record["path"])
            current = snapshot_rollback_file(target, "rollback GC project target")
            if record["prior_exists"]:
                if (current is None or current[1].digest != record["prior_sha256"] or
                        current[1].mode != record["prior_mode"]):
                    conflicts.append(record["path"])
            elif current is not None:
                conflicts.append(record["path"])
        except (HarnessError, KeyError) as exc:
            conflicts.append(f"{record.get('path', '<unknown>')}: {exc}")
    for entry in journal.get("plan", {}).get("mutation_manifest", []):
        if not entry.get("path", "").endswith("/"):
            continue
        target = mutation_target(root, entry["path"])
        try:
            info = target.lstat()
        except FileNotFoundError:
            if entry.get("prior_exists"):
                conflicts.append(entry["path"])
            continue
        if entry["path"] == "@git/harness-control/" and not entry.get("prior_exists"):
            if target.is_symlink() or not stat.S_ISDIR(info.st_mode):
                conflicts.append(entry["path"])
            continue
        if (not entry.get("prior_exists") or target.is_symlink() or
                not stat.S_ISDIR(info.st_mode) or
                stat.S_IMODE(info.st_mode) != entry.get("prior_mode")):
            conflicts.append(entry["path"])
    if conflicts:
        raise HarnessError(f"rollback GC restored project verification failed: {conflicts}")


def gc_transition(journal_path: pathlib.Path, authoritative: dict[str, Any],
                  phase: str, durability_phase: str,
                  values: dict[str, Any] | None = None) -> dict[str, Any]:
    if phase not in ROLLBACK_GC_PHASES:
        raise HarnessError("unknown rollback GC phase")
    current = load_json(journal_path)
    expected_digest = sha256_value(authoritative)
    if (int(current.get("journal_revision", 0)) !=
            int(authoritative.get("journal_revision", 0)) or
            sha256_value(current) != expected_digest):
        raise HarnessError("rollback GC journal CAS conflict")
    updated = clone_json_object(current)
    archive = updated["rollback_archive"]
    if values:
        archive.update(values)
    archive["gc_phase"] = phase
    archive.pop("gc_completed", None)
    save_adoption_journal(journal_path, updated, durability_phase,
                          expected_revision=int(current["journal_revision"]),
                          expected_digest=expected_digest)
    return updated


def gc_bound_paths(journal: dict[str, Any]) -> tuple[pathlib.Path, pathlib.Path]:
    archive = journal["rollback_archive"]
    control = pathlib.Path(journal["repository"]["git_dir"]) / "harness-control"
    return (control / archive["gc_archive_relative_path"],
            control / archive["gc_retained_relative_path"])


def prepare_rollback_gc(root: pathlib.Path, journal_path: pathlib.Path,
                        journal: dict[str, Any]) -> dict[str, Any]:
    archive = journal["rollback_archive"]
    generation = journal["generation_id"]
    inventory = validate_gc_inventory(archive.get("inventory"), generation)
    inventory_digest = sha256_value(inventory)
    if archive.get("inventory_sha256") != inventory_digest:
        raise HarnessError("rollback GC inventory digest mismatch")
    expected_archive_relative = f"rollback-archive/{generation}"
    retained_relative = f"rollback-retained/{generation}-{inventory_digest}"
    if (archive.get("generation_id") != generation or
            archive.get("relative_root") != expected_archive_relative):
        raise HarnessError("rollback GC generation binding mismatch")
    control = pathlib.Path(journal["repository"]["git_dir"]) / "harness-control"
    archive_root = control / expected_archive_relative
    retained_root = control / retained_relative
    identity = gc_root_identity(archive_root, "rollback archive root")
    verify_gc_inventory_root(archive_root, inventory, allow_missing=False)
    if gc_path_exists(retained_root):
        raise HarnessError("rollback GC retained destination unexpectedly exists")
    rollback_gc_fault("before_gc_prepared")
    return gc_transition(
        journal_path, journal, "GC_PREPARED", "rollback_gc_prepared",
        {"inventory_sha256": inventory_digest,
         "gc_inventory_sha256": inventory_digest,
         "gc_archive_relative_path": expected_archive_relative,
         "gc_retained_relative_path": retained_relative,
         "gc_archive_identity": identity,
         "gc_generation_marker": generation,
         "gc_prepared_at": utc_now()},
    )


def validate_prepared_gc(root: pathlib.Path, journal: dict[str, Any]) -> tuple[
        list[dict[str, Any]], pathlib.Path, pathlib.Path, dict[str, Any]]:
    if journal.get("lifecycle_state") != "ADOPTION_ROLLED_BACK":
        raise HarnessError("rollback archive GC requires ADOPTION_ROLLED_BACK")
    verify_restored_project_for_gc(root, journal)
    archive = journal.get("rollback_archive")
    if not isinstance(archive, dict) or not archive.get("project_state_restored"):
        raise HarnessError("rollback archive GC requires verified archive accounting")
    phase = archive.get("gc_phase", "GC_NOT_STARTED")
    if phase not in ROLLBACK_GC_PHASES:
        raise HarnessError("rollback archive GC phase is invalid")
    generation = journal.get("generation_id")
    inventory = validate_gc_inventory(archive.get("inventory"), generation)
    digest = sha256_value(inventory)
    if (archive.get("inventory_sha256") != digest or
            (phase != "GC_NOT_STARTED" and archive.get("gc_inventory_sha256") != digest)):
        raise HarnessError("rollback GC inventory digest mismatch")
    if phase == "GC_NOT_STARTED":
        expected_relative = f"rollback-archive/{generation}"
        if (archive.get("generation_id") != generation or
                archive.get("relative_root") != expected_relative):
            raise HarnessError("rollback archive GC generation binding mismatch")
        control = pathlib.Path(journal["repository"]["git_dir"]) / "harness-control"
        digest = archive["inventory_sha256"]
        return (inventory, control / expected_relative,
                control / f"rollback-retained/{generation}-{digest}", {})
    if (archive.get("generation_id") != generation or
            archive.get("gc_archive_relative_path") != f"rollback-archive/{generation}" or
            archive.get("gc_retained_relative_path") !=
            f"rollback-retained/{generation}-{digest}" or
            archive.get("gc_generation_marker") != generation):
        raise HarnessError("rollback GC path or generation binding mismatch")
    identity = archive.get("gc_archive_identity")
    if (not isinstance(identity, dict) or identity.get("object_type") != "directory"):
        raise HarnessError("rollback GC archive identity is missing")
    if phase == "GC_DETACHED" and archive.get("gc_retained_identity") != identity:
        raise HarnessError("rollback GC retained identity binding mismatch")
    archive_root, retained_root = gc_bound_paths(journal)
    return inventory, archive_root, retained_root, identity


def detach_rollback_gc(root: pathlib.Path, journal_path: pathlib.Path, journal: dict[str, Any],
                       inventory: list[dict[str, Any]], archive_root: pathlib.Path,
                       retained_root: pathlib.Path, identity: dict[str, Any]) -> dict[str, Any]:
    archive_exists = gc_path_exists(archive_root)
    retained_exists = gc_path_exists(retained_root)
    if retained_exists:
        if gc_root_identity(retained_root, "rollback retained archive") != identity:
            raise HarnessError("rollback GC retained root identity mismatch")
        verify_gc_inventory_root(retained_root, inventory, allow_missing=False)
    elif archive_exists:
        if gc_root_identity(archive_root, "rollback archive root") != identity:
            raise HarnessError("rollback GC archive root identity mismatch")
        verify_gc_inventory_root(archive_root, inventory, allow_missing=False)
        ensure_durable_directory(retained_root.parent.parent, retained_root.parent.name, 0o700)
        rollback_gc_fault("retained_parent_durable")
        old_fd = open_directory_nofollow(archive_root.parent)
        new_fd = open_directory_nofollow(retained_root.parent)
        try:
            linux_renameat2_between(old_fd, archive_root.name, new_fd,
                                    retained_root.name, RENAME_NOREPLACE)
            os.fsync(old_fd)
            os.fsync(new_fd)
        finally:
            os.close(old_fd)
            os.close(new_fd)
        rollback_gc_fault("archive_detached")
        rollback_gc_fault("before_gc_detached")
    else:
        raise HarnessError("rollback GC prepared state lost active and retained archives")
    if gc_root_identity(retained_root, "rollback retained archive") != identity:
        raise HarnessError("rollback GC retained root identity mismatch")
    verify_gc_inventory_root(retained_root, inventory, allow_missing=False)
    verify_restored_project_for_gc(root, journal)
    detached = gc_transition(
        journal_path, journal, "GC_DETACHED", "rollback_gc_detached",
        {"gc_detached_at": utc_now(), "gc_retained_identity": identity})
    rollback_gc_fault("gc_detached")
    return detached


def rollback_gc_status(root: pathlib.Path) -> tuple[str | None, list[str]]:
    """Diagnose later namespace drift without rewriting detachment history."""
    journal_path, _ = adoption_control(root)
    if not journal_path.exists():
        return None, []
    journal = load_json(journal_path)
    lifecycle = journal.get("lifecycle_state")
    archive = journal.get("rollback_archive")
    if not isinstance(archive, dict) or archive.get("gc_phase") != "GC_DETACHED":
        return lifecycle, []
    warnings: list[str] = []
    try:
        generation = journal.get("generation_id")
        inventory = validate_gc_inventory(archive.get("inventory"), generation)
        digest = sha256_value(inventory)
        expected_active = f"rollback-archive/{generation}"
        expected_retained = f"rollback-retained/{generation}-{digest}"
        identity = archive.get("gc_retained_identity")
        if (archive.get("inventory_sha256") != digest or
                archive.get("gc_inventory_sha256") != digest or
                archive.get("gc_archive_relative_path") != expected_active or
                archive.get("gc_retained_relative_path") != expected_retained or
                archive.get("gc_generation_marker") != generation or
                not isinstance(identity, dict) or identity.get("object_type") != "directory"):
            raise HarnessError("rollback GC detached journal binding mismatch")
        if archive.get("gc_archive_identity") != identity:
            raise HarnessError("rollback GC detached identity history mismatch")
        control = pathlib.Path(journal["repository"]["git_dir"]) / "harness-control"
        active = control / expected_active
        retained = control / expected_retained
        if gc_path_exists(active):
            warnings.append("UNBOUND_ACTIVE_ARCHIVE_PRESENT")
        if (gc_root_identity(retained, "rollback retained archive") != identity):
            raise HarnessError("rollback GC retained root identity mismatch")
        verify_gc_inventory_root(retained, inventory, allow_missing=False)
    except (HarnessError, KeyError, OSError, TypeError, UnicodeError):
        warnings.append("RETAINED_ARCHIVE_DRIFT")
    return lifecycle, warnings


def mark_rollback_gc_blocked(journal_path: pathlib.Path,
                             authoritative: dict[str, Any], error: Exception) -> None:
    current = load_json(journal_path)
    if (int(current.get("journal_revision", 0)) !=
            int(authoritative.get("journal_revision", 0)) or
            sha256_value(current) != sha256_value(authoritative)):
        return
    archive = current.get("rollback_archive")
    if (not isinstance(archive, dict) or
            archive.get("gc_phase", "GC_NOT_STARTED") in {"GC_NOT_STARTED", "GC_BLOCKED"}):
        return
    gc_transition(journal_path, current, "GC_BLOCKED", "rollback_gc_blocked",
                  {"gc_blocked_error": concise(str(error), 600)})


def garbage_collect_rollback_archive(_args: argparse.Namespace) -> None:
    """Resume journal-authoritative logical detachment into retained storage."""
    root = git_root(True)
    journal_path, _ = adoption_control(root)
    p = paths(root)
    with state_lock(p):
        authoritative = load_json(journal_path)
        try:
            phase = authoritative.get("rollback_archive", {}).get(
                "gc_phase", "GC_NOT_STARTED")
            if phase == "GC_DETACHED":
                return
            inventory, archive_root, retained_root, identity = validate_prepared_gc(
                root, authoritative)
            phase = authoritative["rollback_archive"].get("gc_phase", "GC_NOT_STARTED")
            if phase == "GC_BLOCKED":
                raise HarnessError("rollback archive GC is blocked")
            if phase == "GC_NOT_STARTED":
                authoritative = prepare_rollback_gc(root, journal_path, authoritative)
                rollback_gc_fault("gc_prepared")
                inventory, archive_root, retained_root, identity = validate_prepared_gc(
                    root, authoritative)
                phase = "GC_PREPARED"
            if phase == "GC_PREPARED":
                authoritative = detach_rollback_gc(
                    root, journal_path, authoritative, inventory, archive_root,
                    retained_root, identity)
                return
        except RollbackGCFault:
            raise
        except (HarnessError, OSError, UnicodeError) as exc:
            mark_rollback_gc_blocked(journal_path, authoritative, exc)
            raise


def prepare_adoption_staging(root: pathlib.Path, journal_path: pathlib.Path,
                             journal: dict[str, Any], plan: dict[str, Any], report: str,
                             analyst: dict[str, Any]) -> None:
    stage_root = pathlib.Path(journal["staging_root"])
    public, trusted = adoption_desired_files(root, plan, report, analyst,
                                             journal["generation_id"])
    operation_by_path = {entry["path"]: entry for entry in plan["mutation_manifest"]}
    files: list[dict[str, Any]] = list(journal.get("files", []))
    completed = {(item["area"], item["path"]) for item in files}
    for area, values in (("project", public), ("trusted", trusted)):
        for relative, content in values.items():
            if (area, relative) in completed:
                continue
            destination = stage_root / area / relative
            manifest_path = relative if area == "project" else f"@git/harness-control/{relative}"
            desired_mode = int(operation_by_path[manifest_path]["desired_mode"])
            atomic_write(destination, content.decode("utf-8"), mode=desired_mode)
            label = f"stage_file:{area}:{relative}"
            files.append({"area": area, "path": relative, "sha256": hashlib.sha256(content).hexdigest(),
                          "mode": desired_mode, "label": label})
            journal["files"] = files
            save_adoption_journal(journal_path, journal, label)
    save_adoption_journal(journal_path, journal, "staging_complete")
    for item in files:
        candidate = stage_root / item["area"] / item["path"]
        if candidate.is_symlink() or not candidate.is_file() or hashlib.sha256(candidate.read_bytes()).hexdigest() != item["sha256"]:
            raise HarnessError(f"staged adoption file failed validation: {item['path']}")
    tomllib.loads((stage_root / "project" / ".harness/config.toml").read_text(encoding="utf-8"))
    for relative in ("HARNESS_ADOPTION_REPORT.md", ".harness/PROJECT_STATE.md", ".harness/CURRENT_STAGE.md"):
        ensure_english_artifact(stage_root / "project" / relative, relative)
    journal["files"] = files
    journal["staging_valid"] = True
    save_adoption_journal(journal_path, journal, "staging_validated")


def verify_adoption_journal(root: pathlib.Path, journal: dict[str, Any]) -> None:
    identity = repository_identity(root)
    if journal.get("repository") != identity:
        raise HarnessError("adoption journal repository identity or HEAD changed")
    if journal.get("plan_sha256") != sha256_value(journal.get("plan_core")):
        raise HarnessError("adoption journal plan hash mismatch")
    stage_root = pathlib.Path(journal.get("staging_root", ""))
    if not journal.get("staging_valid") or not stage_root.is_dir() or stage_root.is_symlink():
        raise HarnessError("adoption staging is incomplete")
    for item in journal.get("files", []):
        candidate = stage_root / item["area"] / item["path"]
        if candidate.is_symlink() or not candidate.is_file():
            raise HarnessError("adoption staging file is missing or unsafe")
        if hashlib.sha256(candidate.read_bytes()).hexdigest() != item["sha256"]:
            raise HarnessError("adoption staging hash mismatch")


def verify_adoption_bindings(root: pathlib.Path, p: dict[str, pathlib.Path],
                             lifecycle: dict[str, Any], journal: dict[str, Any]) -> None:
    verify_adoption_journal(root, journal)
    if journal.get("lifecycle_state") not in {"ADOPTION_VALIDATING", "ACTIVATION_VALIDATING",
                                               "ACTIVATION_COMMITTING", "ACTIVATION_COMMITTED"}:
        raise HarnessError("adoption journal is not ready for activation")
    if lifecycle.get("generation_id") != journal.get("generation_id"):
        raise HarnessError("lifecycle generation does not match adoption journal")
    stage_root = pathlib.Path(journal["staging_root"])
    staged_lifecycle = load_json(stage_root / "project/.harness/lifecycle.json")
    if lifecycle != staged_lifecycle:
        raise HarnessError("installed lifecycle state does not match validated staging")
    bindings = lifecycle.get("bindings", {})
    expected = journal.get("plan_core", {}).get("bindings", {})
    for name in ("analyst_report", "auditor_report", "normalized_adoption_report",
                 "generated_config", "protected_paths", "context_files", "quality_gates",
                 "quality_gate_inputs"):
        if bindings.get(name) != expected.get(name):
            raise HarnessError(f"adoption binding mismatch: {name}")
    report_path = root / "HARNESS_ADOPTION_REPORT.md"
    if hashlib.sha256(report_path.read_bytes()).hexdigest() != bindings.get("adoption_report"):
        raise HarnessError("adoption report hash mismatch")
    public_config_hash = hashlib.sha256(p["config"].read_bytes()).hexdigest()
    trusted_config_hash = hashlib.sha256(p["trusted_config"].read_bytes()).hexdigest()
    if public_config_hash != bindings.get("generated_config") or trusted_config_hash != public_config_hash:
        raise HarnessError("generated project configuration hash mismatch")
    if sha256_value(lifecycle.get("protected_paths", [])) != bindings.get("protected_paths"):
        raise HarnessError("protected-path approval binding mismatch")
    if sha256_value(lifecycle.get("context_files", [])) != bindings.get("context_files"):
        raise HarnessError("context-file approval binding mismatch")
    if sha256_value(lifecycle.get("quality_gates", {})) != bindings.get("quality_gates"):
        raise HarnessError("quality-gate approval binding mismatch")
    if sha256_value(journal["plan_core"].get("quality_gate_inputs", [])) != bindings.get("quality_gate_inputs"):
        raise HarnessError("quality-gate executable-input binding mismatch")
    if gate_input_records(root, lifecycle.get("quality_gates", {})) != journal["plan_core"].get("quality_gate_inputs", []):
        raise HarnessError("quality-gate executable input changed before activation")
    for record in lifecycle.get("context_files", []):
        current = safe_project_file(root, record["path"], "bound context file")
        if current != record:
            raise HarnessError("bound context file changed before activation")


def install_adoption_staging(root: pathlib.Path, journal_path: pathlib.Path,
                             journal: dict[str, Any]) -> None:
    verify_adoption_journal(root, journal)
    git_dir = pathlib.Path(journal["repository"]["git_dir"])
    stage_root = pathlib.Path(journal["staging_root"])
    completed = set(journal.get("completed_writes", []))
    journal["lifecycle_state"] = "ADOPTION_IN_PROGRESS"
    save_adoption_journal(journal_path, journal, "adoption_in_progress")
    for relative, directory in ((".harness/", root / ".harness"),
                                (".harness/runtime/", root / ".harness/runtime"),
                                ("@git/harness-control/", git_dir / "harness-control")):
        label = f"install_directory:{relative.rstrip('/')}"
        if label not in completed:
            if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
                raise HarnessError(f"unsafe adoption installation directory: {relative}")
            directory.mkdir(parents=True, exist_ok=True, mode=0o700 if relative.startswith("@git") else 0o755)
            completed.add(label)
            journal["completed_writes"] = sorted(completed)
            save_adoption_journal(journal_path, journal, label)
    for item in journal["files"]:
        label = f"install_file:{item['area']}:{item['path']}"
        source = stage_root / item["area"] / item["path"]
        target = ((root / item["path"]) if item["area"] == "project"
                  else (git_dir / "harness-control" / item["path"]))
        target_matches = False
        if target.is_file() and not target.is_symlink():
            fd = open_single_link_regular(target, require_owner=False)
            with os.fdopen(fd, "rb") as handle:
                info = os.fstat(handle.fileno())
                target_matches = (hashlib.sha256(handle.read()).hexdigest() == item["sha256"] and
                                  stat.S_IMODE(info.st_mode) == int(item["mode"]))
        if not target_matches:
            content = source.read_text(encoding="utf-8")
            atomic_runtime_write(target, content, mode=int(item["mode"]))
        if label not in completed:
            completed.add(label)
            journal["completed_writes"] = sorted(completed)
            save_adoption_journal(journal_path, journal, label)
        fd = open_single_link_regular(target, require_owner=False)
        with os.fdopen(fd, "rb") as handle:
            installed_hash = hashlib.sha256(handle.read()).hexdigest()
        if installed_hash != item["sha256"]:
            raise HarnessError(f"installed adoption file hash mismatch: {item['path']}")
    journal["lifecycle_state"] = "ADOPTION_VALIDATING"
    journal["last_error"] = None
    save_adoption_journal(journal_path, journal, "adoption_validating")


def resume_adoption(root: pathlib.Path) -> None:
    journal_path, _ = adoption_control(root)
    journal = load_json(journal_path)
    if journal.get("lifecycle_state") not in {"ADOPTION_PLANNED", "ADOPTION_IN_PROGRESS",
                                               "ADOPTION_INTERRUPTED", "ADOPTION_VALIDATING"}:
        raise HarnessError("adoption journal is not resumable")
    try:
        if not journal.get("backup_binding"):
            prepare_adoption_backup(root, journal_path, journal)
        if not journal.get("staging_valid"):
            prepare_adoption_staging(root, journal_path, journal, journal["plan"],
                                     journal["report_text"], journal["analyst_report"])
        install_adoption_staging(root, journal_path, journal)
    except Exception as exc:
        mark_adoption_interrupted(root, journal_path, journal, str(exc))
        raise
    emit("adopt", "ok", resumed=True, lifecycle_state="ADOPTION_VALIDATING",
         generation_id=journal["generation_id"])


def adopt_project(args: argparse.Namespace) -> None:
    root = git_root(True)
    validate_engineering_name(root.name, "project directory name")
    if getattr(args, "rollback", False):
        rollback_adoption(root)
        emit("adopt", "ok", rolled_back=True, lifecycle_state="ADOPTION_ROLLED_BACK")
        return
    if getattr(args, "resume", False):
        resume_adoption(root)
        return
    if not args.report or not args.analyst_report or not args.auditor_report:
        raise HarnessError("adopt requires --report, --analyst-report, and --auditor-report")
    detection = lifecycle_detection(root)
    if detection["classification"] != "GIT_WITHOUT_HARNESS":
        raise HarnessError("adopt requires a Git repository without a Harness")
    report, analyst, _auditor, input_hashes = validated_adoption_inputs(root, args)
    plan = build_adoption_plan(root, report, analyst, input_hashes)
    if args.dry_run:
        emit("adopt", "dry-run", business_code_modified=False,
             plan_sha256=plan["plan_sha256"], manifest=plan["canonical_manifest"],
             operations=plan["operations"],
             approval_block=plan["approval_block"])
        return
    if any(entry["action"] == "REJECT" for entry in plan["operations"]):
        raise HarnessError("adoption rejected by the approved mutation manifest")
    language = detect_operator_language(args.operator_input, args.operator_language)
    if not args.approved:
        raise HarnessError(operator_message("approval_required", language))
    if getattr(args, "approved_plan_hash", None) != plan["plan_sha256"]:
        raise HarnessError("approved adoption plan hash does not match the current validated plan")
    if plan["approval_block"] not in report:
        raise HarnessError("HARNESS_ADOPTION_REPORT.md does not contain the exact approved argv manifest")
    journal_path, git_dir = adoption_control(root)
    if journal_path.exists():
        raise HarnessError("an adoption journal already exists; use 'harness adopt --resume'")
    generation = plan["generation_id"]
    journal = {"lifecycle_version": LIFECYCLE_VERSION, "lifecycle_state": "ADOPTION_PLANNED",
               "journal_revision": -1,
               "generation_id": generation, "repository": plan["repository"],
               "plan_sha256": plan["plan_sha256"],
               "plan_core": plan["canonical_manifest"],
               "plan": {key: plan[key] for key in ("lifecycle_version", "repository", "bindings",
                                                    "protected_records", "configured_protected_paths", "context_records", "quality_gates",
                                                    "quality_gate_inputs", "generation_id", "generated_at",
                                                    "mutation_manifest", "plan_sha256", "approval_block",
                                                    "operations", "config", "gitignore")},
               "report_text": report, "analyst_report": analyst,
               "staging_root": str(git_dir / f"harness-adoption-staging-{generation}"),
               "backup_root": str(git_dir / f"harness-adoption-backup-{generation}"),
               "staging_valid": False, "files": [], "completed_writes": [], "created_at": utc_now()}
    save_adoption_journal(journal_path, journal, "adoption_planned")
    try:
        if os.environ.get("HARNESS_ADOPTION_FAULT_AFTER") == "adoption_interrupted":
            raise HarnessError("fault injection before interrupted-state persistence")
        prepare_adoption_backup(root, journal_path, journal)
        prepare_adoption_staging(root, journal_path, journal, plan, report, analyst)
        install_adoption_staging(root, journal_path, journal)
    except Exception as exc:
        mark_adoption_interrupted(root, journal_path, journal, str(exc))
        if not os.environ.get("HARNESS_ADOPTION_FAULT_AFTER"):
            with contextlib.suppress(HarnessError):
                rollback_adoption(root)
        raise
    emit("adopt", "ok", lifecycle_state="ADOPTION_VALIDATING",
         generation_id=generation, plan_sha256=plan["plan_sha256"])


def activation_write(path: pathlib.Path, value: dict[str, Any], phase: str,
                     *, mirror: bool = False) -> None:
    if phase not in ACTIVATION_WRITE_PHASES:
        raise HarnessError(f"unknown activation durability phase: {phase}")
    (atomic_runtime_json if mirror else atomic_json)(path, value)
    if os.environ.get("HARNESS_ACTIVATION_FAULT_AFTER") == phase:
        raise HarnessError(f"fault injection after activation durability phase: {phase}")


def activate_project(args: argparse.Namespace) -> None:
    root = git_root()
    p = paths(root)
    canonical_path = p["trusted"] / "lifecycle.json"
    mirror_path = p["base"] / "lifecycle.json"
    lifecycle = load_json(canonical_path)
    adoption_journal_path, git_dir = adoption_control(root)
    journal_path = (adoption_journal_path if lifecycle.get("source") == "BROWNFIELD_ADOPTION"
                    else git_dir / "harness-activation.json")
    if lifecycle.get("source") == "GREENFIELD_BOOTSTRAP" and not journal_path.exists():
        journal = {"lifecycle_version": LIFECYCLE_VERSION, "lifecycle_state": "SCAFFOLD_PENDING",
                   "generation_id": sha256_value({"root": str(root), "source": "GREENFIELD_BOOTSTRAP"})[:32],
                   "repository": repository_identity(root), "created_at": utc_now(), "files": []}
        save_adoption_journal(journal_path, journal, "adoption_planned")
    else:
        journal = load_json(journal_path)
    if journal.get("repository") != repository_identity(root):
        raise HarnessError("activation journal repository identity or HEAD changed")

    if lifecycle.get("lifecycle_state") == "HARNESS_READY":
        if journal.get("lifecycle_state") != "ACTIVATION_COMMITTED":
            raise HarnessError("canonical readiness exists without a committed activation journal")
        if not mirror_path.is_file() or load_json(mirror_path) != lifecycle:
            activation_write(mirror_path, lifecycle, "lifecycle_mirror_repaired", mirror=True)
        language = detect_operator_language(args.operator_input, args.operator_language)
        emit("activate", "ok", resumed=True, lifecycle_state="HARNESS_READY",
             operator_message=operator_message("harness_ready", language))
        return
    if lifecycle.get("lifecycle_state") not in {"SCAFFOLD_PENDING", "ADOPTION_VALIDATING",
                                                "ACTIVATION_VALIDATING", "ACTIVATION_COMMITTING",
                                                "ACTIVATION_COMMITTED"}:
        raise HarnessError("project is not awaiting lifecycle activation")
    if journal.get("lifecycle_state") in {"SCAFFOLD_PENDING", "ADOPTION_VALIDATING"}:
        if not args.final_review:
            raise HarnessError("initial activation requires --final-review")
        final, final_hash = lifecycle_report_document(pathlib.Path(args.final_review), "final_reviewer")
        if final.get("verdict") != "PASS" or final.get("language_compliance") != "PASS":
            raise HarnessError("final read-only lifecycle review did not pass")
        state = load_state(p)
        if state.get("workflow_state") != "STAGE_COMPLETED":
            raise HarnessError("baseline Stage must complete through the existing Stage/Slice engine")
        if lifecycle.get("source") == "BROWNFIELD_ADOPTION":
            verify_adoption_bindings(root, p, lifecycle, journal)
        evidence = {"final_review_sha256": final_hash,
                    "final_review_document_sha256": sha256_value(final),
                    "workflow_state_sha256": sha256_value(state),
                    "adoption_plan_sha256": journal.get("plan_sha256"),
                    "generation_id": journal["generation_id"]}
        journal["activation_evidence"] = evidence
        journal["lifecycle_state"] = "ACTIVATION_VALIDATING"
        save_adoption_journal(journal_path, journal, "activation_evidence_persisted")
    elif journal.get("lifecycle_state") not in {"ACTIVATION_VALIDATING", "ACTIVATION_COMMITTING",
                                                 "ACTIVATION_COMMITTED"}:
        raise HarnessError("activation journal is not resumable")

    if journal["lifecycle_state"] == "ACTIVATION_VALIDATING":
        activation_write(p["trusted"] / "activation-evidence.json",
                         journal["activation_evidence"], "activation_evidence_file_persisted")
        journal["lifecycle_state"] = "ACTIVATION_COMMITTING"
        save_adoption_journal(journal_path, journal, "activation_committing")
    if journal["lifecycle_state"] == "ACTIVATION_COMMITTING":
        lifecycle["activation_bindings"] = journal["activation_evidence"]
        lifecycle["lifecycle_state"] = "ACTIVATION_COMMITTING"
        lifecycle["updated_at"] = utc_now()
        activation_write(canonical_path, lifecycle, "canonical_activation_bindings")
        journal["lifecycle_state"] = "ACTIVATION_COMMITTED"
        save_adoption_journal(journal_path, journal, "activation_committed")
    if journal["lifecycle_state"] != "ACTIVATION_COMMITTED":
        raise HarnessError("activation did not reach its durable commit point")
    lifecycle = load_json(canonical_path)
    lifecycle["lifecycle_state"] = "HARNESS_READY"
    lifecycle["updated_at"] = utc_now()
    activation_write(canonical_path, lifecycle, "canonical_readiness_published")
    activation_write(mirror_path, lifecycle, "lifecycle_mirror_repaired", mirror=True)
    language = detect_operator_language(args.operator_input, args.operator_language)
    emit("activate", "ok", lifecycle_state="HARNESS_READY",
         operator_message=operator_message("harness_ready", language))


def detect_project(root: pathlib.Path) -> dict[str, Any]:
    context_candidates = [
        "AGENTS.md", "CLAUDE.md", ".cursorrules", "ARCHITECTURE.md", "README.md",
        "PROJECT_BRIEF.md", "HARNESS_ADOPTION_REPORT.md",
        "README.rst", "README.txt", "docs/quality.md", "docs/exec-plans/README.md",
    ]
    context = [name for name in context_candidates if (root / name).is_file()]
    ci = []
    workflows = root / ".github" / "workflows"
    if workflows.is_dir():
        ci = sorted(str(x.relative_to(root)) for x in workflows.iterdir()
                    if x.suffix.lower() in {".yml", ".yaml"})
    detected: list[str] = []
    workspace_members: list[str] = []
    build_entrypoints: list[str] = []
    commands: dict[str, list[str]] = {}
    project_type = "generic"
    cargo = root / "Cargo.toml"
    if cargo.is_file():
        detected.append("Cargo.toml")
        try:
            manifest = tomllib.loads(cargo.read_text(encoding="utf-8")) if tomllib else {}
        except Exception:
            manifest = {}
        workspace = isinstance(manifest.get("workspace"), dict)
        if workspace:
            members = manifest.get("workspace", {}).get("members", [])
            if isinstance(members, list):
                workspace_members = [str(member) for member in members if isinstance(member, str)]
        project_type = "rust-workspace" if workspace else "rust"
        lock = ["--locked"] if (root / "Cargo.lock").is_file() else []
        commands = {
            "formatter": ["cargo", "fmt", "--all", "--check"],
            "lint": ["cargo", "clippy", *lock, "--workspace", "--all-targets", "--all-features", "--", "-D", "warnings"],
            "check": ["cargo", "check", *lock, "--workspace", "--all-targets", "--all-features"],
            "unit_test": ["cargo", "test", *lock, "--workspace"],
            "integration_test": [],
        }
        for name in ("Cargo.lock", "rust-toolchain.toml", "rustfmt.toml"):
            if (root / name).is_file():
                detected.append(name)
    elif (root / "pyproject.toml").is_file():
        detected.append("pyproject.toml")
        project_type = "python"
        commands = {"formatter": ["python", "-m", "ruff", "format", "--check", "."],
                    "lint": ["python", "-m", "ruff", "check", "."],
                    "check": ["python", "-m", "compileall", "-q", "."],
                    "unit_test": ["python", "-m", "pytest", "-q"],
                    "integration_test": []}
    elif (root / "package.json").is_file():
        detected.append("package.json")
        project_type = "node"
        try:
            scripts = json.loads((root / "package.json").read_text(encoding="utf-8")).get("scripts", {})
        except Exception:
            scripts = {}
        package_runner = "npm"
        commands = {
            "formatter": [package_runner, "run", "format", "--", "--check"] if "format" in scripts else [],
            "lint": [package_runner, "run", "lint"] if "lint" in scripts else [],
            "check": [package_runner, "run", "typecheck"] if "typecheck" in scripts else ([package_runner, "run", "build"] if "build" in scripts else []),
            "unit_test": [package_runner, "test", "--", "--runInBand"] if "test" in scripts else [],
            "integration_test": [package_runner, "run", "test:integration"] if "test:integration" in scripts else [],
        }
    elif (root / "go.mod").is_file():
        detected.append("go.mod")
        project_type = "go"
        commands = {"formatter": ["harness", "_gofmt-check"], "lint": ["go", "vet", "./..."],
                    "check": ["go", "test", "-run", "^$", "./..."],
                    "unit_test": ["go", "test", "./..."], "integration_test": []}
    else:
        commands = {name: [] for name in ("formatter", "lint", "check", "unit_test", "integration_test")}
    for name in ("Makefile", "Justfile", "package.json", "pyproject.toml", "go.mod"):
        if (root / name).is_file() and name not in detected:
            detected.append(name)
    if (root / "scripts" / "verify").is_file():
        build_entrypoints.append("scripts/verify")
    return {"project_type": project_type, "context": context, "ci": ci,
            "detected": detected, "workspace_members": workspace_members,
            "build_entrypoints": build_entrypoints, "commands": commands}


def validate_gate_argv(root: pathlib.Path, argv: list[str]) -> list[str]:
    if not argv or not all(isinstance(value, str) and value for value in argv):
        raise HarnessError("quality-gate argv must be a non-empty string array")
    forbidden = {"bash", "sh", "zsh", "fish", "dash", "pwsh", "powershell", "cmd"}
    if (argv[0] in forbidden or any("$(" in value or "`" in value or
                                     re.search(r"[\n\r;|&<>]", value) for value in argv)):
        raise HarnessError(f"unsafe quality-gate argv rejected: {argv!r}")
    allowed = {"cargo", "go", "npm", "make", "harness", "git", "python"}
    if argv[0] == "./scripts/verify":
        safe_project_file(root, "scripts/verify", "quality-gate executable")
    elif argv[0] not in allowed:
        raise HarnessError(f"unapproved quality-gate executable: {argv[0]!r}")
    if argv[0] == "python":
        if "-c" in argv or len(argv) < 3 or argv[1] != "-m" or argv[2] not in {
            "ruff", "compileall", "pytest"
        }:
            raise HarnessError(f"unapproved Python quality-gate argv: {argv!r}")
    if argv[0] == "npm":
        allowed_npm = (
            argv[:3] in (["npm", "run", "format"], ["npm", "run", "lint"],
                         ["npm", "run", "typecheck"], ["npm", "run", "build"],
                         ["npm", "run", "test:integration"]) or
            argv[:2] == ["npm", "test"]
        )
        if not allowed_npm:
            raise HarnessError(f"unapproved npm quality-gate argv: {argv!r}")
    if argv[0] == "cargo" and (len(argv) < 2 or argv[1] not in {"fmt", "clippy", "check", "test"}):
        raise HarnessError(f"unapproved Cargo quality-gate argv: {argv!r}")
    if argv[0] == "go" and (len(argv) < 2 or argv[1] not in {"vet", "test"}):
        raise HarnessError(f"unapproved Go quality-gate argv: {argv!r}")
    if argv[0] == "make" and argv != ["make", "test"]:
        raise HarnessError(f"unapproved Make quality-gate argv: {argv!r}")
    if argv[0] == "git" and argv != ["git", "diff", "--check"]:
        raise HarnessError(f"unapproved Git quality-gate argv: {argv!r}")
    if argv[0] == "harness" and argv != ["harness", "_rust-affected-check"]:
        raise HarnessError(f"unapproved Harness quality-gate argv: {argv!r}")
    if argv[0] == "./scripts/verify" and argv not in (["./scripts/verify", "fast"],
                                                       ["./scripts/verify", "full"]):
        raise HarnessError(f"unapproved verify-script argv: {argv!r}")
    return list(argv)


def derived_gate_commands(root: pathlib.Path, facts: dict[str, Any]) -> dict[str, list[list[str]]]:
    commands = facts["commands"]
    is_rust = str(facts["project_type"]).startswith("rust")
    fast = [["harness", "_rust-affected-check"]] if is_rust else []
    if is_rust and "scripts/verify" in facts["build_entrypoints"]:
        slice_commands = [["./scripts/verify", "fast"],
                          ["cargo", "test", "--locked", "--workspace"]]
        stage_commands = [["./scripts/verify", "full"]]
    else:
        slice_commands = [value for value in commands.values() if value]
        stage_commands = list(slice_commands)
    return {name: [validate_gate_argv(root, list(argv)) for argv in values]
            for name, values in {"fast": fast, "slice": slice_commands,
                                 "stage": stage_commands}.items()}


def render_config(root: pathlib.Path, facts: dict[str, Any]) -> str:
    commands = facts["commands"]
    gates = derived_gate_commands(root, facts)
    protected = [".git/", ".env", ".env.*", ".harness/config.toml",
                 ".harness/state.json", ".harness/runtime/",
                 "AGENTS.md", "ARCHITECTURE.md", "PROJECT_BRIEF.md",
                 "HARNESS_ADOPTION_REPORT.md"]
    protected.extend(path for path in facts.get("validated_protected_paths", [])
                     if path not in protected)
    return f'''config_version = {CONFIG_VERSION}
harness_version = {q(HARNESS_VERSION)}
project_name = {q(root.name)}
project_type = {q(facts["project_type"])}
context_files = {toml_array(facts["context"])}
ci_files = {toml_array(facts["ci"])}
detected_files = {toml_array(facts["detected"])}
workspace_members = {toml_array(facts["workspace_members"])}
build_entrypoints = {toml_array(facts["build_entrypoints"])}
protected_paths = {toml_array(protected)}
max_slice_attempts = 3
error_excerpt_limit = 1200
worker_timeout_seconds = 3600
gate_timeout_seconds = 1800

[commands]
formatter = {toml_array(commands["formatter"])}
lint = {toml_array(commands["lint"])}
check = {toml_array(commands["check"])}
unit_test = {toml_array(commands["unit_test"])}
integration_test = {toml_array(commands["integration_test"])}

[gates]
fast = {toml_commands(gates["fast"])}
slice = {toml_commands(gates["slice"])}
stage = {toml_commands(gates["stage"])}

[agent_runtime]
adapter_argv = ["python3", "{{skill_root}}/adapters/codex_cli.py"]
ephemeral = true

[agent_runtime.models]

[language]
internal_language = "en"
repository_language = "en"
agent_instruction_language = "en"
agent_report_language = "en"
operator_language = "auto"
correct_operator_grammar = false
strict_engineering_language = true
product_localization_paths = []

[context_maintenance]
enabled = true
idle_compaction_threshold = 0.45
max_compactions_per_worker_run = 1
min_tokens_since_last_compaction = 20000
rehydrate_after_compaction = true
'''


def read_approved_plan(root: pathlib.Path, raw_path: str) -> str:
    project_root = root.resolve()
    candidate = pathlib.Path(raw_path)
    if candidate.is_absolute():
        try:
            relative = candidate.relative_to(project_root)
        except ValueError as exc:
            raise HarnessError("approved plan file must be inside the Git project") from exc
    else:
        relative = candidate
    if not relative.parts or any(part in {"", ".", ".."} for part in relative.parts):
        raise HarnessError("approved plan path must be a normalized project-relative path")
    if any(part in {".git", ".harness"} for part in relative.parts):
        raise HarnessError("approved plan file must not be inside .git or .harness")
    relative_text = str(relative)
    if relative.name == ".env" or relative.name.startswith(".env.") or SECRET_NAMES.search(relative_text):
        raise HarnessError("approved plan path is credential-shaped and will not be read")
    directory_fd = open_directory_nofollow(project_root)
    try:
        directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        for part in relative.parts[:-1]:
            next_fd = os.open(part, directory_flags, dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = next_fd
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
        fd = os.open(relative.name, flags, dir_fd=directory_fd)
    except OSError as exc:
        raise HarnessError("approved plan file cannot be safely opened") from exc
    finally:
        os.close(directory_fd)
    try:
        info = validate_single_link_regular(fd, "approved plan file", require_owner=False)
        if info.st_size > 1024 * 1024:
            raise HarnessError("approved plan file exceeds 1 MiB")
        with os.fdopen(fd, "rb") as handle:
            fd = -1
            raw = handle.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise HarnessError("approved plan file exceeds 1 MiB")
        plan = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise HarnessError("approved plan file is not valid UTF-8") from exc
    finally:
        if fd >= 0:
            os.close(fd)
    if not plan.strip():
        raise HarnessError("the approved Stage plan file is empty")
    return plan


def initial_state() -> dict[str, Any]:
    now = utc_now()
    return {"state_version": 1, "state_revision": 0, "harness_version": HARNESS_VERSION,
            "workflow_state": "STAGE_DISCUSSION", "stage_id": None,
            "stage_title": None, "slice_id": None, "attempt": 0,
            "worker_run_seq": 0, "checkpoint_epoch": 0,
            "workflow": None, "required_assessments": [], "completed_assessments": [],
            "tester_outcome": None,
            "gates_passed": False, "gate_level": None, "base_sha": None,
            "candidate_id": None, "validated_worktree": None,
            "verifier_state": "not_required", "evidence_counters": {},
            "worker": None, "owner": None,
            "created_at": now, "updated_at": now,
            "recent_transitions": []}


def parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="harness", description="Provider-neutral project lifecycle harness"
    )
    ap.add_argument("--version", action="version", version=f"harness {HARNESS_VERSION}")
    sub = ap.add_subparsers(dest="command", required=True)
    sp = sub.add_parser("detect", help="read-only project lifecycle detection")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=detect_lifecycle)
    sp = sub.add_parser("assess", help="read-only brownfield architecture assessment")
    sp.add_argument("--analyst-report")
    sp.add_argument("--auditor-report")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--operator-language", choices=("auto", "en", "zh"), default="auto")
    sp.add_argument("--operator-input", default="")
    sp.set_defaults(func=assess_project)
    sp = sub.add_parser("bootstrap", help="initialize an approved greenfield project")
    sp.add_argument("--brief", required=True)
    sp.add_argument("--approved", action="store_true")
    sp.add_argument("--approved-plan-hash")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--operator-language", choices=("auto", "en", "zh"), default="auto")
    sp.add_argument("--operator-input", default="")
    sp.set_defaults(func=bootstrap_project)
    sp = sub.add_parser("adopt", help="initialize an approved brownfield Harness")
    sp.add_argument("--report")
    sp.add_argument("--analyst-report")
    sp.add_argument("--auditor-report")
    sp.add_argument("--approved", action="store_true")
    sp.add_argument("--approved-plan-hash")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--resume", action="store_true")
    sp.add_argument("--rollback", action="store_true")
    sp.add_argument("--operator-language", choices=("auto", "en", "zh"), default="auto")
    sp.add_argument("--operator-input", default="")
    sp.set_defaults(func=adopt_project)
    sub.add_parser(
        "rollback-gc", help="detach a completed rollback archive into retained storage"
    ).set_defaults(func=garbage_collect_rollback_archive)
    sp = sub.add_parser("activate", help="mark a baseline-reviewed project HARNESS_READY")
    sp.add_argument("--final-review")
    sp.add_argument("--resume", action="store_true")
    sp.add_argument("--operator-language", choices=("auto", "en", "zh"), default="auto")
    sp.add_argument("--operator-input", default="")
    sp.set_defaults(func=activate_project)
    return ap


def main() -> int:
    args = parser().parse_args()
    try:
        args.func(args)
        return 0
    except HarnessError as exc:
        emit(args.command or "unknown", "error", error=concise(str(exc), 1200))
        return 2
    except KeyboardInterrupt:
        emit(args.command or "unknown", "interrupted")
        return 130
    except Exception as exc:
        emit(args.command or "unknown", "error", error=concise(f"{type(exc).__name__}: {exc}", 1200))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
